#!/usr/bin/env bash
# Unified vim-style focus movement across nvim splits, herdr panes, and
# Hyprland windows. Bound to SUPER+h/j/k/l in bindings.lua.
#
# Order of precedence for a direction:
#   1. If the focused window is the herdr terminal AND its current pane runs
#      nvim -> ask nvim to move between its splits (RPC over nvim's server
#      socket). If nvim actually moved, stop.
#   2. Else if herdr has a pane in that direction -> focus it.
#   3. Else -> move Hyprland window focus.
#
# No nvim plugin needed: nvim's built-in server socket lives at
# $XDG_RUNTIME_DIR/nvim.<pid>.0, and one --remote-expr both moves and reports
# whether it was already at the edge.
#
# A FLOATING nvim window declines outright. "Did the current window change?" is
# the right test for a normal split and a lie for a float: floats are not in the
# layout tree, so `wincmd h|j|k|l` from one all land on the same place -- the
# last-accessed window -- and every direction reports a move. Without the guard
# a snacks picker or lazygit swallows all four directions and herdr never sees
# them. Nothing to special-case for the snacks terminal: `Snacks.terminal()`
# with no command is a bottom split, so it is a normal window here.
#
# ponytail: assumes a single terminal window and that terminal == herdr (true
# on this box). Omarchy 4 ships foot; ghostty kept for pre-4 installs. Each keypress spawns a few short-lived queries; latency is a few
# tens of ms over local sockets — fine for interactive focus.
set -euo pipefail

TERM_CLASSES="foot com.mitchellh.ghostty"

# Omarchy 4 routes hyprctl dispatch through Lua; the old bare form is rejected.
movefocus() { exec hyprctl dispatch "hl.dsp.focus({ direction = \"$1\" })"; }

hdir="$1"                       # l | r | u | d  (Hyprland movefocus arg)
case "$hdir" in
  l) herdr=left;  win=h ;;
  r) herdr=right; win=l ;;
  u) herdr=up;    win=k ;;
  d) herdr=down;  win=j ;;
  *) echo "usage: herdr-nav l|r|u|d" >&2; exit 2 ;;
esac

# Focused window not the terminal? Plain Hyprland focus move.
case " $TERM_CLASSES " in
  *" $(hyprctl activewindow -j | jq -r '.class') "*) ;;
  *) movefocus "$hdir" ;;
esac

# In the terminal: if the current herdr pane runs nvim, let nvim move first.
nvim_pid=$(herdr pane process-info --current 2>/dev/null \
  | jq -r '.result.process_info.foreground_processes[]? | select(.name=="nvim") | .pid' \
  | head -1)
if [ -n "$nvim_pid" ]; then
  sock="$XDG_RUNTIME_DIR/nvim.$nvim_pid.0"
  if [ -S "$sock" ]; then
    moved=$(nvim --server "$sock" --remote-expr \
      "luaeval('(function() local a=vim.api.nvim_get_current_win() if vim.api.nvim_win_get_config(a).relative~=\"\" then return 0 end pcall(vim.cmd,\"wincmd $win\") return a~=vim.api.nvim_get_current_win() and 1 or 0 end)()')" \
      2>/dev/null || echo 0)
    [ "$moved" = "1" ] && exit 0   # moved between nvim splits; done
  fi
fi

# nvim absent or at its edge: try a herdr pane in that direction.
changed=$(herdr pane focus --direction "$herdr" --current 2>/dev/null \
  | jq -r '.result.focus.changed // false')
[ "$changed" = "true" ] && exit 0

# herdr also at its edge: cross into the next Hyprland window.
movefocus "$hdir"
