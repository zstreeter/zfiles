# sioyek preferences for the Windows build, installed by windows/install.ps1.
#
# Separate from sioyek/.config/sioyek/ (the Linux package) because the two
# targets need different content, not because the file is duplicated for its
# own sake. On Omarchy prefs_user.config is a SYMLINK to the theme engine's
# rendered sioyek-prefs.config and changes on every theme switch; Windows has
# no theme engine, so this is a static file. The keymap, which is identical on
# both sides, is not copied here -- install.ps1 installs the Linux package's
# keys_user.config verbatim.
#
# Catppuccin Mocha, matching the yazi flavor fallback. Sioyek wants each
# channel as a float in [0.0, 1.0].
background_color 0.118 0.118 0.180
custom_background_color 0.118 0.118 0.180
custom_text_color 0.804 0.839 0.957
text_highlight_color 0.976 0.886 0.686
synctex_highlight_color 0.537 0.706 0.980
link_highlight_color 0.537 0.706 0.980
search_highlight_color 0.345 0.357 0.439

# custom_background_color and custom_text_color above only reach the page once
# custom color mode is ON, which is a runtime toggle rather than a preference.
# The Linux wrapper (sioyek/.local/bin/sioyek) does this by prepending
# `--execute-command toggle_custom_color` to a fresh launch, and has to guard
# that with a pidof check so a second invocation does not flip the running
# instance back out. startup_commands has no such hazard: sioyek is
# single-instance, and a second `sioyek file.pdf` hands the file to the window
# that is already open without re-running any of this.
startup_commands toggle_custom_color
