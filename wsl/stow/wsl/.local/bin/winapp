#!/bin/bash

set -u

if [[ $# -lt 1 ]]; then
    echo "usage: winapp <exe-name> [args...]" >&2
    exit 2
fi

if ! grep -qi microsoft /proc/version 2>/dev/null; then
    echo "winapp: not running under WSL — no Windows side to route to" >&2
    exit 1
fi

exe_name=$1
shift

win_local_appdata() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zfiles/localappdata"
    local value
    if [[ -r $cache ]]; then
        value=$(<"$cache")
        [[ -d $value ]] && { printf '%s\n' "$value"; return 0; }
    fi

    local raw
    raw=$(cd /mnt/c && cmd.exe /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r\n')
    [[ -n $raw && $raw != '%LOCALAPPDATA%' ]] || return 1

    value=$(wslpath -u "$raw" 2>/dev/null) || return 1
    [[ -d $value ]] || return 1

    mkdir -p "${cache%/*}" && printf '%s\n' "$value" > "$cache"
    printf '%s\n' "$value"
}

find_exe() {
    local name=$1 appdata candidate

    candidate=$(command -v "$name" 2>/dev/null) && [[ -x $candidate ]] && {
        printf '%s\n' "$candidate"; return 0
    }

    appdata=$(win_local_appdata) || return 1

    candidate="$appdata/Microsoft/WinGet/Links/$name"
    [[ -x $candidate ]] && { printf '%s\n' "$candidate"; return 0; }

    candidate="$appdata/Programs/$name"
    [[ -x $candidate ]] && { printf '%s\n' "$candidate"; return 0; }

    return 1
}

exe=$(find_exe "$exe_name") || {
    cat >&2 <<EOF
winapp: '$exe_name' not found on the Windows side.
  Re-run bootstrap.sh (it installs these via windows/install.ps1), or install
  it by hand with: winget install <id>
EOF
    exit 127
}

args=()
for arg in "$@"; do
    if [[ -e $arg ]]; then
        args+=("$(wslpath -w "$arg")")
    else
        args+=("$arg")
    fi
done

exec "$exe" "${args[@]}"
