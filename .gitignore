.zsh_history
tmux/.config/tmux/plugins/
**/.zcompdump
yazi/.config/yazi/package.toml
cura/.local/share/cura/.sentry-native/
cura/.local/share/cura/stderr.log
cura/.local/share/cura/stdout.log

# API keys. secrets.env is the real path (~/.config/shell/secrets.env, created
# by bootstrap outside the repo); the other two are historical/mistyped names
# that have shown up in-tree before. Ignore all of them everywhere — a folded
# stow symlink is all it takes for one to land inside the repo.
**/secrets.env
**/secrets.sh

# Editor/tool backup droppings (yazi writes keymap.toml-<epoch> on upgrade)
**/*.toml-[0-9]*

# pi runtime data — secrets, sessions, and migration artifacts.
# The directory itself is stowed; these specific files must never be tracked.
pi/.config/pi/agent/auth.json
pi/.config/pi/agent/auth.json.migrated
pi/.config/pi/agent/oauth.json
pi/.config/pi/agent/oauth.json.migrated
pi/.config/pi/agent/sessions/
pi/.config/pi/agent/*.jsonl

# Defense-in-depth: yazi's theme is a runtime symlink at ~/.config/yazi/
# flavors/zfiles.yazi, never inside the package. If either shows up here it
# means stow folded the directory and the symlink landed in-tree — which
# bootstrap's NO_FOLD_PACKAGES is supposed to prevent.
yazi/.config/yazi/omarchy-theme.toml
yazi/.config/yazi/flavors/

# Zap installs zsh plugins to ~/.local/share/zap, never in-tree. A copy here
# is fallout from the same folding bug.
zsh/.config/zsh/zsh-syntax-highlighting/
