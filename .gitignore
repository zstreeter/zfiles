.zsh_history
**/.zcompdump
common/stow/yazi/.config/yazi/package.toml
omarchy/stow/cura/.local/share/cura/.sentry-native/
omarchy/stow/cura/.local/share/cura/stderr.log
omarchy/stow/cura/.local/share/cura/stdout.log

# API keys. secrets.env is the real path (~/.config/shell/secrets.env, created
# by bootstrap outside the repo); the other name is a historical/mistyped one
# that has shown up in-tree before. Ignore all of them everywhere — a folded
# stow symlink is all it takes for one to land inside the repo.
**/secrets.env
**/secrets.sh

# Editor/tool backup droppings (yazi writes keymap.toml-<epoch> on upgrade)
**/*.toml-[0-9]*

# pi runtime data — secrets, sessions, and migration artifacts.
# The directory itself is stowed; these specific files must never be tracked.
common/stow/pi/.config/pi/agent/auth.json
common/stow/pi/.config/pi/agent/auth.json.migrated
common/stow/pi/.config/pi/agent/oauth.json
common/stow/pi/.config/pi/agent/oauth.json.migrated
common/stow/pi/.config/pi/agent/sessions/
common/stow/pi/.config/pi/agent/*.jsonl

# Defense-in-depth: yazi's theme is a runtime symlink at ~/.config/yazi/
# flavors/zfiles.yazi, never inside the package. If either shows up here it
# means stow folded the directory and the symlink landed in-tree — which
# bootstrap's blanket --no-folding is supposed to prevent.
common/stow/yazi/.config/yazi/omarchy-theme.toml
common/stow/yazi/.config/yazi/flavors/

# Zap installs zsh plugins to ~/.local/share/zap, never in-tree. A copy here
# is fallout from the same folding bug.
common/stow/zsh/.config/zsh/zsh-syntax-highlighting/

# herdr-navd is an extensionless Python script, so importing or running it in
# place leaves bytecode next to the stowed original.
**/__pycache__/

# Claude Code agent worktrees — scratch, never part of the dotfiles
.claude/worktrees/
