#!/usr/bin/env bash
# check — fast, offline checks for the breakage this repo has actually shipped.
#
#   common/githooks/check     run from anywhere in the repo; pre-push runs it too
#
# Each check is one class of bug that reached main before: a script that no
# longer parses, a Lua file broken by a comment pass, a --help that prints code
# because its header was stripped, and paperctl logic its selftests cover.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0
bad() { echo "check: $*" >&2; fail=1; }

while IFS= read -r f; do
    case $(head -1 "$f") in
        '#!/bin/sh'|'#!/usr/bin/env sh') sh -n "$f" 2>&1 || bad "sh syntax: $f" ;;
        '#!'*bash*) bash -n "$f" 2>&1 || bad "bash syntax: $f" ;;
    esac
    # A script that prints its own header as help must still have that header.
    range=$(grep -o "sed -n '[0-9]*,[0-9]*p' \"[$]0\"" "$f" | head -1 | grep -o '[0-9]*,[0-9]*')
    if [[ -n $range ]] && sed -n "${range}p" "$f" | grep -qv '^#'; then
        bad "help header: $f prints non-comment lines $range"
    fi
done < <(git ls-files -z | xargs -0 grep -lI '^#!' 2>/dev/null)

while IFS= read -r f; do
    if [[ $f == */zsh/* ]]; then
        command -v zsh >/dev/null && { zsh -n "$f" 2>&1 || bad "zsh syntax: $f"; }
    else
        bash -n "$f" 2>&1 || bad "bash syntax: $f"
    fi
done < <(git ls-files '*.sh')

if command -v luac >/dev/null; then
    while IFS= read -r f; do
        luac -p "$f" 2>&1 || bad "lua syntax: $f"
    done < <(git ls-files '*.lua')
fi

(
    cd common/stow/paperctl/.local/lib || exit 1
    python3 -I -c 'import sys; sys.path.insert(0, ".")
from paperctl import library, alphaxiv
library._selftest(); alphaxiv.demo()' >/dev/null
) || bad "paperctl selftests failed"

((fail)) && exit 1
echo "check: ok"
