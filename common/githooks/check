#!/usr/bin/env bash
# check — fast, offline checks for the breakage this repo has actually shipped.
#
#   common/githooks/check     run from anywhere in the repo; pre-push runs it too
#
# Each check is one class of bug that reached main before: a script that no
# longer parses, a Lua file broken by a comment pass, a --help that prints code
# because its header was stripped -- then tests/unit.sh.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0
bad() { echo "check: $*" >&2; fail=1; }

while IFS= read -r f; do
    [[ -f $f ]] || continue
    case $f:$(head -c 40 "$f" | head -1) in
        */zsh/*.sh:*)                  parser="zsh -n" ;;
        *:'#!/bin/sh'|*:'#!/usr/bin/env sh') parser="sh -n" ;;
        *.sh:*|*:'#!'*bash*)           parser="bash -n" ;;
        *.lua:*)                       parser="luac -p" ;;
        *) continue ;;
    esac
    # Parsers this machine lacks are skipped, not failed.
    command -v "${parser% *}" >/dev/null || continue
    $parser "$f" 2>&1 >/dev/null || bad "$parser syntax: $f"
    # A script that prints its own header as help must still have that header.
    range=$(grep -o "sed -n '[0-9]*,[0-9]*p' \"[$]0\"" "$f" | head -1 | grep -o '[0-9]*,[0-9]*')
    if [[ -n $range ]] && sed -n "${range}p" "$f" | grep -qv '^#'; then
        bad "help header: $f prints non-comment lines $range"
    fi
done < <(git ls-files)

# shellcheck, on the scripts already held clean (add a path once it passes). A missing
# shellcheck -- not installed, uvx offline with nothing cached -- skips, never blocks.
if command -v shellcheck >/dev/null; then sc=(shellcheck)
else sc=(uvx -q --offline --from shellcheck-py shellcheck); fi
if "${sc[@]}" --version >/dev/null 2>&1; then
    "${sc[@]}" -s bash common/stow/sandbox/.local/bin/* >&2 || bad "shellcheck: common/stow/sandbox/.local/bin"
    "${sc[@]}" -s sh common/stow/sandbox/.local/share/agent-sandbox/agent-job >&2 || bad "shellcheck: agent-job"
fi

tests/unit.sh >/dev/null || bad "unit tests failed (run tests/unit.sh)"

((fail)) && exit 1
echo "check: ok"
