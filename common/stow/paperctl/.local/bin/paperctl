#!/usr/bin/env python3
"""Launcher: find the paperctl package next to this script and run it.

Stow makes ~/.local/bin/paperctl a symlink into the zfiles checkout, so the
package has to be located relative to the RESOLVED path -- ~/.local/lib is a
sibling of ~/.local/bin only after the symlink is followed. Resolving also
keeps __pycache__ out of the repo, since the real package lives under
~/.local/lib/paperctl/ as stow's --no-folding directory of symlinks.
"""

import sys
from pathlib import Path

_here = Path(__file__).resolve()
for _lib in (_here.parent.parent / "lib",          # ~/.local/bin -> ~/.local/lib
             _here.parent.parent / ".local" / "lib"):  # running from the repo
    if (_lib / "paperctl" / "cli.py").exists():
        sys.path.insert(0, str(_lib))
        break
else:
    sys.exit("paperctl: cannot find the paperctl package. "
             "Re-run ./bootstrap.sh to restow it.")

from paperctl.cli import main  # noqa: E402

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        # Piping into head closes the pipe early; that is not an error, and the
        # default handler prints a traceback at exit for it.
        import os
        os._exit(0)
