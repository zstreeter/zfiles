#!/usr/bin/env bash
set -euo pipefail
pane="${1:-${HERDR_ACTIVE_PANE_ID:-$HERDR_PANE_ID}}"
f=$(mktemp -t herdr-scrollback.XXXXXX)
trap 'rm -f "$f"' EXIT
herdr pane read "$pane" --source recent-unwrapped --lines "${LINES_BACK:-5000}" --format text \
  | sed 's/[[:space:]]*$//' > "$f"
vis=$(herdr pane read "$pane" --source visible --format text | wc -l)
[ "$(wc -l < "$f")" -le "$vis" ] &&
  sed -i '1i # herdr-scrollback: only the visible screen was captured (pane busy?). Retry when the agent is idle.' "$f"
exec "${EDITOR:-nvim}" -R +'normal! G' "$f"
