#!/bin/bash

if grep -qi microsoft /proc/version 2>/dev/null; then
    WINAPP="$HOME/.local/bin/winapp"
    [[ -x $WINAPP ]] || WINAPP=winapp
    exec "$WINAPP" sioyek.exe "$@"
fi

SIOYEK=/usr/bin/sioyek

if pidof "$SIOYEK" >/dev/null; then
    exec "$SIOYEK" "$@"
fi

exec "$SIOYEK" --execute-command toggle_custom_color "$@"
