#!/usr/bin/env bash
# lean-sandbox -- one shared Lean 4 + Mathlib project for scratch proofs, plus
# helpers to start real projects. elan itself is installed by bootstrap
# (common/setup.sh); everything heavy (Mathlib, ~5 GB of .olean) is fetched
# here, on first use, never at bootstrap.
set -euo pipefail

ELAN_HOME="${ELAN_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/elan}"
export ELAN_HOME PATH="$ELAN_HOME/bin:$PATH"
SANDBOX="${LEAN_SANDBOX:-${XDG_DATA_HOME:-$HOME/.local/share}/lean/sandbox}"
MATHLIB_TOOLCHAIN="leanprover-community/mathlib4:lean-toolchain"

die() { echo "lean-sandbox: $*" >&2; exit 1; }

usage() {
    cat <<EOF
usage: lean-sandbox <command>
  init                 create the shared sandbox ($SANDBOX), fetch Mathlib cache, build
  path                 print the sandbox directory
  check FILE.lean      compile FILE against the sandbox's Mathlib; fail on errors,
                       'sorry', a missing '#print axioms', or non-standard axioms
  new NAME [DIR]       new Mathlib project DIR/NAME (default DIR: .), cache fetched
  update               move the sandbox to Mathlib master's toolchain, lake update, re-fetch
  mcp                  register lean-lsp-mcp with pi (user level), idempotent
EOF
}

need_elan() {
    command -v elan >/dev/null || die "elan not found -- re-run zfiles bootstrap.sh (or see the lean skill)"
}

# Fetch prebuilt Mathlib .olean files instead of compiling Mathlib (hours).
fetch_and_build() {
    (cd "$1" && lake exe cache get && lake build)
}

new_project() {
    local name="$1" dir="$2"
    need_elan
    [[ -e "$dir/$name" ]] && die "$dir/$name already exists"
    mkdir -p "$dir"
    (cd "$dir" && lake +"$MATHLIB_TOOLCHAIN" new "$name" math)
    fetch_and_build "$dir/$name"
}

# The math template turns on Mathlib's contribution style linters (module
# doc-strings, line length): right for a project headed into Mathlib, noise on
# every scratch file. The sandbox only; `new` projects keep them.
quiet_sandbox_linters() {
    [[ -f "$SANDBOX/lakefile.toml" ]] && sed -i '/^weak\.linter\.mathlibStandardSet/d' "$SANDBOX/lakefile.toml"
    return 0
}

cmd_init() {
    if [[ -f "$SANDBOX/lakefile.toml" || -f "$SANDBOX/lakefile.lean" ]]; then
        echo "sandbox exists: $SANDBOX"
        quiet_sandbox_linters
        fetch_and_build "$SANDBOX"
        return
    fi
    new_project "$(basename "$SANDBOX")" "$(dirname "$SANDBOX")"
    quiet_sandbox_linters
    mkdir -p "$SANDBOX/Scratch"
    cat > "$SANDBOX/Scratch/Hello.lean" <<'EOF'
import Mathlib

theorem two_mul_self (n : ℕ) : 2 * n = n + n := by ring

#print axioms two_mul_self
EOF
    "$0" check "$SANDBOX/Scratch/Hello.lean"
}

cmd_check() {
    local file="${1:-}"
    [[ -f "$file" ]] || die "check: no such file '$file'"
    [[ -d "$SANDBOX" ]] || die "no sandbox yet -- run: lean-sandbox init"
    file="$(realpath "$file")"
    local out rc=0
    out="$(cd "$SANDBOX" && lake env lean "$file" 2>&1)" || rc=$?
    printf '%s\n' "$out"
    ((rc == 0)) || die "FAIL: lean exited $rc"
    grep -q "declaration uses .sorry.\|sorryAx" <<<"$out" && die "FAIL: proof uses sorry"
    grep -q "depends on axioms\|does not depend on any axioms" <<<"$out" \
        || die "FAIL: no '#print axioms <thm>' in file -- axioms unchecked"
    # #print axioms output: anything beyond the three standard axioms is flagged. Lean wraps a
    # long list over several lines, so join them first.
    local extra
    extra="$(tr '\n' ' ' <<<"$out" | grep -o "depends on axioms: \[[^]]*\]" | tr -d '[]' \
        | sed 's/.*axioms: //' | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$' \
        | grep -v -x 'propext\|Classical.choice\|Quot.sound' | sort -u || true)"
    [[ -z "$extra" ]] || die "FAIL: non-standard axioms: $(tr '\n' ' ' <<<"$extra")"
    echo "PASS: $file"
}

cmd_update() {
    [[ -d "$SANDBOX" ]] || die "no sandbox yet -- run: lean-sandbox init"
    (cd "$SANDBOX" \
        && curl -fsSL https://raw.githubusercontent.com/leanprover-community/mathlib4/master/lean-toolchain -o lean-toolchain \
        && lake update)
    fetch_and_build "$SANDBOX"
}

cmd_mcp() {
    command -v pi >/dev/null || die "pi not installed"
    command -v uvx >/dev/null || die "uvx not found (install uv)"
    if pi mcp list 2>/dev/null | grep -q 'lean-lsp'; then
        echo "lean-lsp MCP already registered"
    else
        pi mcp add lean-lsp -- uvx lean-lsp-mcp
    fi
}

case "${1:-}" in
    init) cmd_init ;;
    path) echo "$SANDBOX" ;;
    check) shift; cmd_check "$@" ;;
    new) shift; [[ -n "${1:-}" ]] || die "new: NAME required"; new_project "$1" "${2:-.}" ;;
    update) cmd_update ;;
    mcp) cmd_mcp ;;
    -h|--help|help|"") usage ;;
    *) usage; exit 2 ;;
esac
