#!/usr/bin/env bash
set -uo pipefail

ROOT="$HOME/.agents/skills"
CLAUDE="$HOME/.claude/skills"
CODEX="$HOME/.codex/skills"

LIST=false
[[ ${1:-} == --list ]] && LIST=true
[[ ${1:-} == -h || ${1:-} == --help ]] && { sed -n '2,5p' "$0" | sed 's/^# \?//'; exit 0; }

[[ -d $ROOT ]] || { echo "agent-skills: no $ROOT — nothing to link"; exit 0; }

shopt -s nullglob
skills=("$ROOT"/*/)
((${#skills[@]})) || { echo "agent-skills: $ROOT is empty"; exit 0; }

if $LIST; then
    printf '%-24s %-8s %-8s %s\n' SKILL claude codex pi
    for dir in "${skills[@]}"; do
        name=$(basename "$dir")
        c=no; x=no
        [[ -e "$CLAUDE/$name" ]] && c=yes
        [[ -e "$CODEX/$name" ]] && x=yes
        printf '%-24s %-8s %-8s %s\n' "$name" "$c" "$x" native
    done
    exit 0
fi

linked=0 skipped=0
for target in "$CLAUDE" "$CODEX"; do
    parent=$(dirname "$target")
    [[ -d $parent ]] || continue
    mkdir -p "$target"

    for dir in "${skills[@]}"; do
        name=$(basename "$dir")
        link="$target/$name"
        src="${dir%/}"

        if [[ -L $link ]]; then
            ln -sfn "$src" "$link"
            ((linked++))
        elif [[ -e $link ]]; then
            echo "agent-skills: $link is a real directory, leaving it alone" >&2
            ((skipped++))
        else
            ln -sfn "$src" "$link"
            ((linked++))
        fi
    done
done

echo "agent-skills: linked $linked, skipped $skipped (pi reads $ROOT directly)"
