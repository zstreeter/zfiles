#!/usr/bin/env bash
# new-research-project <name>
# Scaffolds a new research vault under ~/research/<name> from the zfiles vault template.
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: new-research-project <name>" >&2
    exit 1
fi

NAME="$1"

# WHERE VAULTS LIVE
# On WSL, Obsidian is the *Windows* build (the target's standing rule: anything
# with a window is the Windows program). A vault under $HOME is only reachable
# from there over \\wsl$\, which is slow and drops file-watch events, so the
# vault goes on the Windows filesystem and WSL reaches it through /mnt/c.
# Everywhere else ~/research is correct. obsidian-vault resolves either.
is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

if [[ -n ${ZFILES_VAULT_ROOT:-} ]]; then
    RESEARCH_ROOT="$ZFILES_VAULT_ROOT"
elif is_wsl; then
    # %USERPROFILE% via APPDATA, not a guessed /mnt/c/Users/$USER: the Windows
    # and Linux account names differ on a domain-joined machine, which this is.
    _appdata=$(cd /mnt/c && cmd.exe /c 'echo %APPDATA%' 2>/dev/null | tr -d '\r\n')
    if [[ -n $_appdata && $_appdata != '%APPDATA%' ]]; then
        _appdata=$(wslpath -u "$_appdata" 2>/dev/null) || _appdata=""
    else
        _appdata=""
    fi
    if [[ -n $_appdata ]]; then
        RESEARCH_ROOT="${_appdata%/AppData/Roaming}/vaults"
    else
        echo "ERR: cannot resolve %USERPROFILE% -- is cmd.exe reachable?" >&2
        echo "     Set ZFILES_VAULT_ROOT to the vault root and re-run." >&2
        exit 1
    fi
else
    RESEARCH_ROOT="$HOME/research"
fi

VAULT_DIR="$RESEARCH_ROOT/$NAME"
# Every vault has a matching PDF library, managed by paperctl.
LIBRARY_DIR="$HOME/Library/$NAME"
TEMPLATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zfiles/vault-template"

if [[ ! -d "$TEMPLATE_DIR" ]]; then
    echo "ERR: vault template not found at $TEMPLATE_DIR" >&2
    echo "     Run zfiles bootstrap.sh first." >&2
    exit 1
fi

if [[ -e "$VAULT_DIR" ]]; then
    echo "ERR: $VAULT_DIR already exists" >&2
    exit 1
fi

mkdir -p "$RESEARCH_ROOT"
# -L dereferences: the template's _quarto.yml, AGENTS.md and README.md are
# RELATIVE symlinks back into zfiles (../../../../zfiles/...), which resolve
# only at the template's own directory depth. A plain `cp -r` copies the link
# text verbatim and every one of them dangles in the new vault -- and a missing
# _quarto.yml is the silent failure this template warns about: Quarto renders
# with no reader extensions, no filter and no pdf format, and reports no error.
# Copy the CONTENT, so a vault is self-contained and survives zfiles moving.
cp -rL "$TEMPLATE_DIR" "$VAULT_DIR"

# Empty references.bib so Quarto's bibliography ref resolves before BBT writes it
touch "$VAULT_DIR/references.bib"

# The paper library for this vault. paperctl files PDFs here with a README index
# and library.bib; `paperctl add --to <NAME>` is the only thing that should write
# to it. Created now so the mapping vault <-> library is never ambiguous.
mkdir -p "$LIBRARY_DIR"

cat <<EOF

Created vault:   $VAULT_DIR
Paper library:   $LIBRARY_DIR

Next steps:
  1. Open the vault in Obsidian (File → Open vault → $VAULT_DIR), then install the
     community plugins listed in $VAULT_DIR/README.md.

  2. Configure Better BibTeX auto-export in Zotero to:
       $VAULT_DIR/references.bib
     Format: Better BibLaTeX, On change.

  3. Inside the vault: \`quarto preview\` to live-render drafts.

  4. File papers for this vault (PDF + metadata + BibTeX):
       paperctl add <title|arxiv-id|doi|url> --to $NAME
       paperctl bib --folder $NAME --out $VAULT_DIR/library.bib

  5. To publish a draft:
       publish-post       $VAULT_DIR/drafts/<file>.qmd    # github.io blog
       publish-confluence $VAULT_DIR/drafts/<file>.qmd    # work Confluence

EOF
