#!/usr/bin/env bash
# obsidian-vault — resolve Obsidian vault locations on any zfiles target.
#
#   obsidian-vault path [<name>]   absolute POSIX path to a vault
#   obsidian-vault name [<path>]   vault name (what obsidian:// URIs want)
#   obsidian-vault list            every known vault, "name<TAB>path"
#   obsidian-vault config          path to Obsidian's own obsidian.json
#
# WHY THIS EXISTS
# Two of the three things that want a vault path -- obsidian-open and
# obsidian-render -- need it on targets where Obsidian itself is a *Windows*
# program (WSL), so neither the config location nor the recorded paths are
# POSIX. Resolution is fiddly enough, and wrong often enough, to be worth one
# script rather than three copies.
#
# THE REGISTRY IS OBSIDIAN'S OWN
# Obsidian records every vault it has opened in obsidian.json:
#
#   {"vaults":{"<hash>":{"path":"C:\\Users\\...\\Vault","ts":1690000000,"open":true}}}
#
# That file is the source of truth rather than anything zfiles writes, because
# it is what the app acts on -- a vault this script invented but Obsidian has
# never opened cannot be addressed by an obsidian:// URI at all. It is created
# on FIRST LAUNCH, not by the installer, so a freshly installed Obsidian has no
# registry and every lookup here has to survive its absence. Hence the
# filesystem fallbacks below.
#
# jq is deliberately not used: it isn't in wsl/pkglist.txt and isn't installed
# on the WSL target. python3 is present everywhere, same call the herdr-navd
# daemon makes for the same reason.
set -uo pipefail

die() { echo "obsidian-vault: $*" >&2; exit 1; }

is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

# %APPDATA% as a POSIX path. Same approach and same caching rationale as
# winapp's win_local_appdata: WSL exports no equivalent, and guessing
# /mnt/c/Users/$USER breaks the moment the Windows and Linux account names
# differ -- the normal case on a domain-joined machine, which this one is.
win_appdata() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zfiles/appdata"
    local value raw
    if [[ -r $cache ]]; then
        value=$(<"$cache")
        [[ -d $value ]] && { printf '%s\n' "$value"; return 0; }
    fi
    # cd out of the WSL filesystem: cmd.exe cannot set a UNC working directory
    # and warns on stderr before falling back to C:\Windows.
    raw=$(cd /mnt/c && cmd.exe /c 'echo %APPDATA%' 2>/dev/null | tr -d '\r\n')
    [[ -n $raw && $raw != '%APPDATA%' ]] || return 1
    value=$(wslpath -u "$raw" 2>/dev/null) || return 1
    [[ -d $value ]] || return 1
    mkdir -p "${cache%/*}" && printf '%s\n' "$value" > "$cache"
    printf '%s\n' "$value"
}

# Where Obsidian keeps obsidian.json. On WSL the app is the Windows build --
# the target's standing rule is that anything with a window is the Windows
# program (see wsl/stow/wsl/.local/bin/winapp) -- so the config is under
# %APPDATA%, not $XDG_CONFIG_HOME.
obsidian_config() {
    local appdata
    if is_wsl; then
        appdata=$(win_appdata) || return 1
        printf '%s\n' "$appdata/obsidian/obsidian.json"
    elif [[ $(uname -s) == Darwin ]]; then
        printf '%s\n' "$HOME/Library/Application Support/obsidian/obsidian.json"
    else
        printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/obsidian/obsidian.json"
    fi
}

# Registered vaults, most-recently-used first, as "path" lines. Paths recorded
# by a Windows Obsidian are Windows paths, so they are translated here; a vault
# whose drive is not mounted is dropped rather than reported as a dead path.
registry_vaults() {
    local cfg
    cfg=$(obsidian_config) || return 1
    [[ -r $cfg ]] || return 1

    python3 - "$cfg" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding='utf-8') as fh:
        vaults = json.load(fh).get('vaults', {})
except (OSError, ValueError):
    sys.exit(1)
# "open" marks the vault showing in the app right now; ts is last-opened.
# Sorting on (open, ts) makes "the vault he's looking at" win, and falls back
# to most-recent when the app is closed and nothing is flagged open.
for v in sorted(vaults.values(),
                key=lambda v: (bool(v.get('open')), v.get('ts', 0)),
                reverse=True):
    p = v.get('path')
    if p:
        print(p)
PY
}

to_posix() {
    local p=$1
    if [[ $p == [A-Za-z]:* || $p == '\\\\'* ]]; then
        wslpath -u "$p" 2>/dev/null || return 1
    else
        printf '%s\n' "$p"
    fi
}

is_vault() { [[ -d "$1/.obsidian" ]]; }

# Every vault this machine knows about, deduplicated, best candidate first.
#
# Order is deliberate. The registry comes first because it is what Obsidian
# will actually act on. ~/research/* comes next -- those are the vaults
# new-research-project scaffolds, and a freshly scaffolded one is a real vault
# on disk before Obsidian has ever opened it, so it exists here and nowhere
# else. The scan is last and is bounded: it is the only way to find a vault
# that predates zfiles, but an unbounded walk of /mnt/c is minutes long.
_all_vaults_raw() {
    local p posix

    while IFS= read -r p; do
        [[ -n $p ]] || continue
        posix=$(to_posix "$p") || continue
        [[ -d $posix ]] || continue
        printf '%s\n' "$posix"
    done < <(registry_vaults)

    for p in "$HOME"/research/*/; do
        p=${p%/}
        is_vault "$p" && printf '%s\n' "$p"
    done

    if is_wsl; then
        local userprofile
        userprofile=$(win_appdata) && userprofile=${userprofile%/AppData/Roaming}
        if [[ -d ${userprofile:-} ]]; then
            while IFS= read -r p; do
                printf '%s\n' "${p%/.obsidian}"
            done < <(find "$userprofile" -maxdepth 5 -name .obsidian -type d 2>/dev/null)
        fi
    fi
}

# The same vault reaches _all_vaults_raw from more than one source -- a
# ~/research vault that has been opened is in the registry too -- so the
# dedup is what makes "first line" mean "best candidate".
all_vaults() { _all_vaults_raw | awk '!seen[$0]++'; }

cmd_list() {
    local p
    while IFS= read -r p; do
        printf '%s\t%s\n' "$(basename "$p")" "$p"
    done < <(all_vaults)
}

# ZFILES_OBSIDIAN_VAULT is the escape hatch and wins outright -- set it in
# ~/.config/shell/secrets.env or per-invocation to pin a vault on a machine
# whose registry says something else.
cmd_path() {
    local want=${1:-} p

    if [[ -z $want && -n ${ZFILES_OBSIDIAN_VAULT:-} ]]; then
        [[ -d $ZFILES_OBSIDIAN_VAULT ]] \
            || die "ZFILES_OBSIDIAN_VAULT is set but not a directory: $ZFILES_OBSIDIAN_VAULT"
        printf '%s\n' "$ZFILES_OBSIDIAN_VAULT"
        return 0
    fi

    # An explicit argument may be a name or a path.
    if [[ -n $want ]]; then
        if [[ -d $want ]]; then
            printf '%s\n' "$(cd "$want" && pwd)"
            return 0
        fi
        while IFS= read -r p; do
            [[ $(basename "$p") == "$want" ]] && { printf '%s\n' "$p"; return 0; }
        done < <(all_vaults)
        die "no vault named '$want' (try: obsidian-vault list)"
    fi

    p=$(all_vaults | head -1)
    [[ -n $p ]] || die "no vault found. Open one in Obsidian once, run
  new-research-project <name>, or set ZFILES_OBSIDIAN_VAULT."
    printf '%s\n' "$p"
}

cmd_name() {
    local p
    p=$(cmd_path "${1:-}") || exit 1
    basename "$p"
}

case ${1:-path} in
    path)   shift $(($# ? 1 : 0)); cmd_path "${1:-}" ;;
    name)   shift $(($# ? 1 : 0)); cmd_name "${1:-}" ;;
    list)   cmd_list ;;
    config) obsidian_config || die "cannot locate obsidian.json" ;;
    -h|--help|help)
        sed -n '2,9p' "$0" | sed 's/^# \?//' ;;
    *) die "unknown subcommand '$1' (path|name|list|config)" ;;
esac
