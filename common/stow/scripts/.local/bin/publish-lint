#!/usr/bin/env python3
"""publish-lint <file> [--target blog|confluence-md|confluence-quarto]

Refuse to publish anything a reader on another machine cannot use. Called by
publish-post and publish-confluence before they write anything; exits 1 and lists
every offending line.

  * local paths, anywhere -- prose AND code blocks (a path in a code block leaks
    just the same): ~/  $HOME  /home/  /mnt/<drive>/  C:\\  file://
  * links whose target is not a real web link (http(s)://, mailto:, #anchor)
  * [[Note]] wikilinks: they point at a vault note the reader cannot open
  * images that will not travel: a local image must sit next to the draft (that
    is what publish-post copies); confluence-md uploads no local images at all
  * confluence-md only: citation keys. On that path nothing resolves [[@key]] or
    @key into a reference, so they would publish as bare keys. The Quarto paths
    resolve them against the bibliography and are fine.

Code and maths are masked first (zdraft, the same definition publish-confluence
uses), so $[[n,k,d]]$ is not read as a wikilink.
"""
import argparse, os, re, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import zdraft  # noqa: E402

LOCAL = re.compile(r"~/|\$HOME\b|/home/|/mnt/[a-z]/|\b[A-Za-z]:\\|file://")
WEB = re.compile(r"^(https?://|mailto:|#)")
IMG_EXT = (".png", ".jpg", ".jpeg", ".svg", ".gif", ".webp")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("file")
    ap.add_argument("--target", choices=["blog", "confluence-md", "confluence-quarto"], default="blog")
    a = ap.parse_args()
    src = open(a.file, encoding="utf-8").read()
    here = os.path.dirname(os.path.abspath(a.file))
    bad = []

    # 1. local paths: raw text, nothing masked.
    for n, line in enumerate(src.splitlines(), 1):
        if LOCAL.search(line):
            bad.append((n, "local path", line))

    body = zdraft.masked(src)       # same length, newlines kept: line numbers survive
    lines = src.splitlines()

    for n, line in enumerate(body.splitlines(), 1):
        orig = lines[n - 1]
        # 3./4. wikilinks ([[@key]] is a citation: step 5)
        for m in re.finditer(r"(!?)\[\[([^\]|#]+)[^\]]*\]\]", line):
            embed, target = m.group(1), m.group(2).strip()
            if target.startswith("@"):
                continue
            if embed and target.lower().endswith(IMG_EXT):
                if a.target == "confluence-md":
                    bad.append((n, "local image (not uploaded)", orig))
                elif not os.path.exists(os.path.join(here, os.path.basename(target))):
                    bad.append((n, "image not next to the draft (will not be copied)", orig))
            else:
                bad.append((n, "link to a vault note readers cannot open", orig))
        # 2./4. markdown links and images
        for m in re.finditer(r"(!?)\[[^\]]*\]\(([^)\s]+)[^)]*\)", line):
            embed, target = m.group(1), m.group(2)
            if WEB.match(target):
                continue
            if embed and target.lower().endswith(IMG_EXT) and a.target != "confluence-md" \
                    and os.path.exists(os.path.join(here, target)) and "/" not in target:
                continue
            bad.append((n, "not a web link" if not embed else "local image will not travel", orig))

    # 5. citations, [[@key]] or @key, on the confluence markdown path
    if a.target == "confluence-md":
        for n in sorted({src.count("\n", 0, at) + 1 for at, _ in zdraft.citekeys(src)}):
            bad.append((n, "citation key not resolved on this path", lines[n - 1]))

    if bad:
        bad.sort(key=lambda b: b[0])
        print(f"publish-lint: {a.file} is not publishable ({a.target}):", file=sys.stderr)
        for n, why, line in bad:
            print(f"  line {n}: {why}\n      {line.strip()[:120]}", file=sys.stderr)
        print("Use real web links (https://...), or plain text. Nothing local is ever published.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
