#!/usr/bin/env bash
# Make every skill in ~/.agents/skills a slash command in opencode (/wayfinder,
# /grill-with-docs...). opencode already discovers the skills for its `skill`
# tool; it just has no slash command for them. pi already has /skill:<name>.
# Re-run after adding skills. Idempotent: regenerates the whole dir.
set -euo pipefail
out=~/.config/opencode/command
mkdir -p "$out"
grep -lsF "generated by opencode-skill-commands" "$out"/*.md | xargs -r rm -f || true
for f in ~/.agents/skills/*/SKILL.md; do
  name=$(basename "$(dirname "$f")")
  desc=$(sed -n '/^---$/,/^---$/{s/^description: *//p}' "$f" | head -1 | cut -c1-120)
  printf -- '---\ndescription: %s\n---\n<!-- generated by opencode-skill-commands -->\nLoad the `%s` skill with the skill tool and follow it exactly. Arguments: $ARGUMENTS\n' \
    "${desc:-$name skill}" "$name" > "$out/$name.md"
done
echo "wrote $(ls "$out"/*.md | wc -l) commands to $out"
