#!/usr/bin/env bash
# publish-post <draft.qmd|draft.md> [slug] [--push]
#
# Copies a vault draft into the blog at
#   ~/Documents/Repos/zstreeter.github.io/posts/YYYY-MM-DD-<slug>/index.qmd
# along with its images, the vault's bibliographies, and the vault's Obsidian
# filter. The blog's GitHub Action renders and publishes on every push to main,
# so --push is the whole deploy; without it, review with `quarto preview` first.
set -euo pipefail

PUSH=0
ARGS=()
for a in "$@"; do
    case $a in
        --push) PUSH=1 ;;
        *) ARGS+=("$a") ;;
    esac
done
set -- "${ARGS[@]}"

if [[ $# -lt 1 ]]; then
    echo "usage: publish-post <draft.qmd|draft.md> [slug] [--push]" >&2
    exit 1
fi

DRAFT="$1"
SLUG="${2:-$(basename "${DRAFT%.*}")}"
BLOG_DIR="$HOME/Documents/Repos/zstreeter.github.io"

if [[ ! -f "$DRAFT" ]]; then
    echo "ERR: draft not found: $DRAFT" >&2
    exit 1
fi

# Nothing local is ever published: refuse before touching the blog repo.
publish-lint "$DRAFT" --target blog

if [[ ! -d "$BLOG_DIR" ]]; then
    echo "ERR: blog repo not found at $BLOG_DIR" >&2
    exit 1
fi

# Front matter is read by zdraft, the module every publish script shares.
ZLIB="$(dirname "$(readlink -f "$0")")/../lib"
field() { PYTHONPATH="$ZLIB" python3 -m zdraft field "$DRAFT" "$1"; }

# The post's date is the draft's front-matter date when it has one, else today.
DATE=$(field date) || true
DATE=${DATE:0:10}
[[ $DATE =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || DATE=$(date +%Y-%m-%d)
POST="posts/${DATE}-${SLUG}"
DEST_DIR="$BLOG_DIR/$POST"

if [[ -e "$DEST_DIR" ]]; then
    echo "ERR: $DEST_DIR already exists. Edit there directly or remove it first." >&2
    exit 1
fi

mkdir -p "$DEST_DIR"
cp "$DRAFT" "$DEST_DIR/index.qmd"

# Adjacent images: Quarto resolves a post's image paths relative to its dir.
DRAFT_DIR=$(dirname "$DRAFT")
shopt -s nullglob
for f in "$DRAFT_DIR"/*.{png,jpg,jpeg,svg,gif,webp}; do
    cp "$f" "$DEST_DIR/"
done
shopt -u nullglob

# Bibliographies travel with the post and are pinned in its front matter.
# Otherwise the post renders against whatever the blog configures (nothing),
# and every citekey silently resolves to nothing -- Quarto does not fail on an
# unresolved @key.
# The vault is wherever .obsidian/ is above the draft, however deep it sits; a
# draft outside any vault takes the bibliographies beside it.
VAULT_ROOT=$(obsidian-vault of "$DRAFT" 2>/dev/null) || VAULT_ROOT=$(cd "$DRAFT_DIR" && pwd)
BIBS=()
for b in references.bib library.bib; do
    if [[ -s "$VAULT_ROOT/$b" ]]; then
        cp "$VAULT_ROOT/$b" "$DEST_DIR/"
        BIBS+=("$b")
    fi
done

# Only inject when the draft has front matter that does not already declare one
# (field exits 1 for "absent", 2 for "no front matter at all").
rc=0; field bibliography >/dev/null || rc=$?
if [[ ${#BIBS[@]} -gt 0 && $rc == 1 ]]; then
    LIST=$(IFS=,; echo "${BIBS[*]}")
    awk -v list="[$LIST]" 'NR>1 && /^---$/ && !done {print "bibliography: " list; done=1} {print}' \
        "$DEST_DIR/index.qmd" > "$DEST_DIR/index.qmd.tmp"
    mv "$DEST_DIR/index.qmd.tmp" "$DEST_DIR/index.qmd"
    echo "Pinned bibliography: [$LIST]"
fi

# The blog renders with the same Obsidian filter as the vault (its _quarto.yml
# declares the from:/filters: pair). Refresh the filter from the vault that
# produced the post, so the two copies cannot drift.
if [[ -d "$VAULT_ROOT/_extensions/obsidian" ]]; then
    mkdir -p "$BLOG_DIR/_extensions"
    rm -rf "$BLOG_DIR/_extensions/obsidian"
    cp -rL "$VAULT_ROOT/_extensions/obsidian" "$BLOG_DIR/_extensions/"
    grep -q 'obsidian.lua' "$BLOG_DIR/_quarto.yml" 2>/dev/null \
        || echo "WARN: $BLOG_DIR/_quarto.yml does not load _extensions/obsidian/obsidian.lua; wikilinks, callouts and ==marks== will render as text" >&2
fi

echo "Published to $DEST_DIR"
if (( PUSH )); then
    git -C "$BLOG_DIR" add "$POST"
    [[ -d "$BLOG_DIR/_extensions" ]] && git -C "$BLOG_DIR" add _extensions
    git -C "$BLOG_DIR" commit -q -m "post: ${SLUG}"
    git -C "$BLOG_DIR" push -q
    echo "Pushed. GitHub Actions is rendering https://zstreeter.github.io/${POST}/"
else
    echo "Preview:  cd $BLOG_DIR && quarto preview $POST/"
    echo "Publish:  cd $BLOG_DIR && git add $POST _extensions && git commit -m 'post: $SLUG' && git push"
fi
