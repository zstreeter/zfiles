#!/usr/bin/env bash
set -uo pipefail

die() { echo "obsidian-open: $*" >&2; exit 1; }
is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

VAULT_ARG=""
while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--vault) VAULT_ARG=${2:-}; shift 2 ;;
        -h|--help) sed -n '2,8p' "$0" | sed 's/^# \?//'; exit 0 ;;
        --) shift; break ;;
        -*) die "unknown option '$1'" ;;
        *) break ;;
    esac
done

TARGET=${1:-}

if [[ -n $TARGET && -e $TARGET && -z $VAULT_ARG ]]; then
    abs=$(cd "$(dirname "$TARGET")" && pwd)/$(basename "$TARGET")
    dir=$(dirname "$abs")
    while [[ $dir != / ]]; do
        if [[ -d "$dir/.obsidian" ]]; then
            VAULT_ARG=$dir
            TARGET=${abs#"$dir"/}
            break
        fi
        dir=$(dirname "$dir")
    done
fi

VAULT_PATH=$(obsidian-vault path "$VAULT_ARG") || exit 1
VAULT_NAME=$(basename "$VAULT_PATH")

URI=$(python3 - "$VAULT_NAME" "$TARGET" <<'PY'
import sys, urllib.parse
vault, target = sys.argv[1], sys.argv[2]
uri = "obsidian://open?vault=" + urllib.parse.quote(vault, safe="")
if target:
    # Obsidian resolves `file` with or without the .md extension; strip it so a
    # note and a wikilink to it produce the same URI.
    if target.endswith(".md"):
        target = target[:-3]
    uri += "&file=" + urllib.parse.quote(target, safe="")
print(uri)
PY
) || die "could not build URI"

if is_wsl; then
    exe=""
    for candidate in \
        "$(command -v Obsidian.exe 2>/dev/null || true)" \
        "$(obsidian-vault config 2>/dev/null | sed 's|/AppData/Roaming/obsidian/obsidian.json||')/AppData/Local/Programs/Obsidian/Obsidian.exe"
    do
        [[ -n $candidate && -x $candidate ]] && { exe=$candidate; break; }
    done
    [[ -n $exe ]] || die "Obsidian not found on the Windows side.
  Re-run zfiles bootstrap.sh (wsl/windows/install.ps1 installs it), or:
    winget install --id Obsidian.Obsidian --scope user"
    nohup "$exe" "$URI" >/dev/null 2>&1 &
    disown
elif command -v obsidian >/dev/null 2>&1; then
    nohup obsidian "$URI" >/dev/null 2>&1 &
    disown
elif command -v xdg-open >/dev/null 2>&1; then
    nohup xdg-open "$URI" >/dev/null 2>&1 &
    disown
else
    die "Obsidian not installed. On Omarchy: sudo pacman -S obsidian"
fi

printf 'obsidian: %s%s\n' "$VAULT_NAME" "${TARGET:+ → $TARGET}"
