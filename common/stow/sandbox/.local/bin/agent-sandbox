#!/usr/bin/env bash
# agent-sandbox -- server half of the ssh agent sandbox. ssh-sandbox (the laptop half)
# ships this file into ~/.agent-sandbox/ for one session and runs it over your normal
# ssh; `down` removes the jail, the key and every file the session made, this one
# included. In between, the sandbox key's every login is forced into `gate`.
#
# The agent runs on the host itself, in a bubblewrap jail that shows only what it
# lists: the system (/usr, /etc, /opt read-only), GPU devices, and the session's
# workspace -- your home, /var (docker, lxd and other root-equivalent sockets) and
# /run are simply not there, and it has its own pid, ipc and (by default) network
# namespace. Its `docker` reaches the daemon only through agent-docker-proxy, which
# refuses anything that could reach the host. Nothing in a repo needs to know.
set -euo pipefail

ROOT=$HOME/.agent-sandbox
SESSION=$ROOT/session
LABEL=zfiles.agent-sandbox # on the volume and every container the agent starts
PROBE=agent-sandbox-probe

die()  { echo "agent-sandbox: $*" >&2; exit 1; }
warn() { echo "agent-sandbox: warning: $*" >&2; }

usage() {
    cat <<EOF
usage: agent-sandbox <command> [options]      (run by ssh-sandbox; not by hand)
  up [opts] < KEY.pub   start the session's jail and docker proxy, force this key into
                        'gate NAME' until --ttl
  down [--force]        remove containers, jail, key, workspace and $ROOT; verify nothing
                        is left ($ROOT/audit.log goes too: ssh-sandbox down copies it first)
  status                the session, its jobs' server and the agent's containers
  gate NAME             the forced command of the sandbox key (sshd runs it)

up options:
  --image IMAGE          an image the agent's docker may run (repeatable; the first is
                         \$AGENT_SANDBOX_IMAGE); pin by digest (IMAGE@sha256:...)
  --name NAME            session name (default: \${USER}_agent)
  --workspace DIR        the agent's home and only writable dir (default ~/agent-sandbox/NAME)
  --ttl HOURS            the key stops working after this, down or not (default 12)
  --from ADDRS           accept the key only from these addresses (from="..."); ssh-sandbox
                         passes the laptop's tailnet addresses when it connects over Tailscale
  --network none|host    the jail's network, and so its containers' (default none)
  --env KEY=VALUE        env in the jail; never put secrets here
  --force                (up, down) end running jobs and the agent's containers
EOF
}

NAME="${USER:-$(id -un)}_agent" NETWORK=none TTL=12 WORKSPACE="" FORCE=0 CREATED="" FROM=""
IMAGES=() ENVS=()

parse_opts() {
    while (($#)); do
        [[ $1 == --force ]] && { FORCE=1; shift; continue; }
        (($# >= 2)) || die "$1 needs a value"
        case $1 in
            --name) [[ $2 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "bad name: $2"; NAME=$2 ;;
            --image) [[ $2 =~ ^[A-Za-z0-9][A-Za-z0-9_./:@-]*$ ]] || die "bad image: $2"; IMAGES+=("$2") ;;
            --ttl) [[ $2 =~ ^[1-9][0-9]*$ && $2 -le 168 ]] || die "bad --ttl (hours, 1-168): $2"; TTL=$2 ;;
            --from) [[ $2 =~ ^[0-9A-Fa-f.:/]+(,[0-9A-Fa-f.:/]+)*$ ]] || die "bad --from (comma-separated addresses): $2"; FROM=$2 ;;
            --network) [[ $2 =~ ^(none|host)$ ]] || die "bad --network (none|host): $2"; NETWORK=$2 ;;
            --workspace) WORKSPACE=$2 ;;
            --env) [[ $2 =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "bad --env: $2"; ENVS+=("$2") ;;
            *) usage >&2; die "unknown option: $1" ;;
        esac
        shift 2
    done
}

# What `down` and `gate` need, written by `up`.
load_session() {
    [[ -f $SESSION ]] || return 1
    local k v
    IMAGES=() ENVS=()
    while IFS='=' read -r k v; do
        case $k in
            name) NAME=$v ;; workspace) WORKSPACE=$v ;; blob) KBLOB=$v ;; created) CREATED=$v ;;
            network) NETWORK=$v ;; image) IMAGES+=("$v") ;; env) ENVS+=("$v") ;;
        esac
    done <"$SESSION"
}

alive() { # pidfile: is it still the process we started?
    local pid
    pid=$(cat "$1" 2>/dev/null) && [[ $pid =~ ^[0-9]+$ ]] && grep -qa "$2" "/proc/$pid/cmdline" 2>/dev/null
}
stop() { alive "$1" "$2" && kill "$(cat "$1")"; rm -f "$1"; }
volume() { printf 'agent-sandbox-%s' "$NAME"; }
containers() { docker ps -q "$@" --filter "label=$LABEL=$NAME"; }

# The jail: only what is listed exists. Later binds cover earlier ones.
jail_args() {
    local d p
    JAIL=(bwrap --unshare-all --new-session --die-with-parent --clearenv
        --ro-bind /usr /usr --ro-bind /etc /etc --proc /proc --ro-bind /sys /sys
        --dev /dev --tmpfs /tmp --tmpfs /run --dir /var/tmp)
    [[ $NETWORK == host ]] && JAIL+=(--share-net)
    for d in /bin /sbin /lib /lib32 /lib64 /libx32 /opt; do
        if [[ -L $d ]]; then JAIL+=(--symlink "$(readlink "$d")" "$d")
        elif [[ -d $d ]]; then JAIL+=(--ro-bind "$d" "$d"); fi
    done
    for p in /dev/kfd /dev/dri /dev/nvidia*; do [[ -e $p ]] && JAIL+=(--dev-bind "$p" "$p"); done
    JAIL+=(--bind "$WORKSPACE" "$WORKSPACE" --ro-bind "$ROOT/run" /run/agent-sandbox --chdir "$WORKSPACE"
        --setenv HOME "$WORKSPACE" --setenv USER "$(id -un)" --setenv LOGNAME "$(id -un)"
        --setenv PATH "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/run/agent-sandbox/bin"
        --setenv TERM "${TERM:-dumb}" --setenv LANG "${LANG:-C.UTF-8}"
        --setenv AGENT_SANDBOX 1 --setenv AGENT_SANDBOX_IMAGE "${IMAGES[0]-}"
        --setenv DOCKER_HOST unix:///run/agent-sandbox/docker.sock
        --setenv AGENT_JOB_SOCK "$WORKSPACE/.agent-jobs.sock")
    for p in "${ENVS[@]}"; do JAIL+=(--setenv "${p%%=*}" "${p#*=}"); done
}

guard() {
    local j c
    j=$(gate_run agent-job running 2>&1) || { ((FORCE)) || die "cannot list jobs ($j); pass --force to end the session anyway"; }
    c=$(containers 2>&1) || die "cannot list the agent's containers: $c"
    [[ -z $j$c ]] && return 0
    ((FORCE)) && { warn "ending jobs and containers: $(tr -c '[:print:]' ' ' <<<"$j $c")"; return 0; }
    die "still running -- jobs: $(tr -c '[:print:]' ' ' <<<"$j") containers: $(tr '\n' ' ' <<<"$c")-- wait for them or pass --force"
}

read_pubkey() {
    local key t
    key=$(head -c 16384 | tr -d '\r')
    [[ $(wc -l <<<"$key") == 1 ]] || die "expected exactly one public key on stdin"
    read -r KTYPE KBLOB _ <<<"$key"
    [[ $KTYPE =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)$ ]] ||
        die "not a bare public key (options are added here, not accepted): ${KTYPE:-empty}"
    [[ $KBLOB =~ ^[A-Za-z0-9+/]+=*$ ]] || die "malformed key blob"
    t=$(mktemp); printf '%s %s\n' "$KTYPE" "$KBLOB" >"$t"
    ssh-keygen -lf "$t" >/dev/null 2>&1 || { rm -f "$t"; die "ssh-keygen rejects this key"; }
    rm -f "$t"
}

# Rewrite authorized_keys without any line carrying this key, then optionally add one.
rewrite_keys() {
    local ak=$HOME/.ssh/authorized_keys tmp
    (umask 077 && mkdir -p "$HOME/.ssh"); touch "$ak"
    tmp=$(mktemp "$HOME/.ssh/.authorized_keys.XXXXXX")
    awk -v b="$KBLOB" '{ for (i = 1; i <= NF; i++) if ($i == b) next } 1' "$ak" >"$tmp"
    [[ -n ${1-} ]] && printf '%s\n' "$1" >>"$tmp"
    chmod 600 "$tmp" && mv -f "$tmp" "$ak"
}

cmd_up() {
    local me expiry ws want=$NAME want_ws=$WORKSPACE i img e
    command -v bwrap >/dev/null || die "needs bubblewrap (bwrap) on this server"
    me=$(realpath -e -- "$0")
    [[ $me == "$ROOT/agent-sandbox" ]] || die "run from $ROOT (ssh-sandbox ships it there), not $me"
    [[ $me =~ ^/[A-Za-z0-9_./-]+$ ]] || die "path unsafe to quote in authorized_keys: $me"
    read_pubkey
    local images=("${IMAGES[@]}") envs=("${ENVS[@]}") network=$NETWORK
    if load_session; then
        [[ $NAME == "$want" ]] || die "a session named $NAME is already here: ssh-sandbox down it first"
        # down removes the session's workspace by what up recorded: never switch it mid-session.
        [[ -z $want_ws || $(realpath -m -- "$want_ws") == "$WORKSPACE" ]] ||
            die "this session's workspace is $WORKSPACE: ssh-sandbox down it first to use $want_ws"
        guard # a re-up restarts the jail, which ends its jobs
    fi
    IMAGES=("${images[@]}") ENVS=("${envs[@]}") NETWORK=$network NAME=$want
    WORKSPACE=${WORKSPACE:-${want_ws:-$HOME/agent-sandbox/$NAME}}
    # down deletes the workspace only if this session made it: never a directory you had.
    if [[ -e $WORKSPACE ]]; then CREATED=${CREATED:-0}; else CREATED=1; fi
    (umask 077 && mkdir -p "$WORKSPACE")
    ws=$(realpath -e -- "$WORKSPACE"); WORKSPACE=$ws
    [[ $ws == "$(realpath -e -- "$HOME")" || $ws == / ]] && die "the workspace cannot be your home or /"
    [[ $ws =~ ^/[A-Za-z0-9_./-]+$ ]] || die "workspace path has characters unsafe here: $ws"
    for img in "${IMAGES[@]}"; do docker image inspect "$img" >/dev/null 2>&1 || die "no image $img on this host"; done

    {
        printf 'name=%s\nworkspace=%s\nblob=%s\ncreated=%s\nnetwork=%s\n' "$NAME" "$ws" "$KBLOB" "$CREATED" "$NETWORK"
        for img in "${IMAGES[@]}"; do printf 'image=%s\n' "$img"; done
        for e in "${ENVS[@]}"; do printf 'env=%s\n' "$e"; done
    } >"$SESSION"
    : >>"$ROOT/audit.log" # exists from the start, so down can always copy it

    # The jail sees $ROOT/run read-only at /run/agent-sandbox: the proxy's socket, agent-job.
    stop "$ROOT/jobs.pid" bwrap; stop "$ROOT/docker.pid" agent-docker-proxy
    mkdir -p "$ROOT/run/bin"
    install -m 755 "$ROOT/agent-job" "$ROOT/run/bin/agent-job"
    docker volume create --driver local --opt type=none --opt o=bind --opt "device=$ws" \
        --label "$LABEL=$NAME" "$(volume)" >/dev/null || die "cannot create the workspace volume"
    local up=/var/run/docker.sock
    [[ ${DOCKER_HOST:-} == unix://* ]] && up=${DOCKER_HOST#unix://}
    python3 -c 'import json, sys; a = sys.argv; json.dump(dict(name=a[2], label=a[3], volume=a[4], workspace=a[5],
        network=a[6], upstream=a[7], socket=a[8], pidfile=a[9], audit=a[10], images=a[11:]), open(a[1], "w"))' \
        "$ROOT/docker.json" "$NAME" "$LABEL" "$(volume)" "$ws" "$NETWORK" "$up" \
        "$ROOT/run/docker.sock" "$ROOT/docker.pid" "$ROOT/audit.log" ${IMAGES[@]+"${IMAGES[@]}"}
    setsid -f python3 "$ROOT/agent-docker-proxy" "$ROOT/docker.json" >>"$ROOT/docker-proxy.log" 2>&1 </dev/null
    # Jobs outlive every login: their tmux server runs in a jail of its own, started here.
    jail_args
    rm -f "$ws/.agent-jobs.sock"
    setsid -f "${JAIL[@]}" -- tmux -S "$ws/.agent-jobs.sock" -D >>"$ROOT/jobs.log" 2>&1 </dev/null
    for ((i = 0; i < 50; i++)); do [[ -S $ROOT/run/docker.sock && -S $ws/.agent-jobs.sock ]] && break; sleep 0.1; done
    [[ -S $ROOT/run/docker.sock ]] || die "the docker proxy did not start: $(tail -3 "$ROOT/docker-proxy.log")"
    [[ -S $ws/.agent-jobs.sock ]] || die "the jobs jail did not start: $(tail -3 "$ROOT/jobs.log")"
    pgrep -of -- "^bwrap .*-S $ws/.agent-jobs.sock -D" >"$ROOT/jobs.pid" || die "cannot find the jobs jail"

    # restrict: no agent/port/X11 forwarding, no ~/.ssh/rc; pty back on for shells.
    # expiry-time: the key dies on its own if `down` never runs (laptop lost, session abandoned).
    expiry=$(date -d "+$TTL hours" +%Y%m%d%H%M) # server-local: sshd before 9.x rejects a Z suffix
    rewrite_keys "restrict,pty,${FROM:+from=\"$FROM\",}expiry-time=\"$expiry\",command=\"$me gate $NAME\" $KTYPE $KBLOB agent-sandbox"
    echo "agent-sandbox: $NAME up (network=$NETWORK images=${IMAGES[*]:-none} workspace=$ws, key expires $expiry${FROM:+, only from $FROM})"
}

# Undo all of `up`, then prove it.
cmd_down() {
    local left=() c
    load_session || die "no session here ($SESSION missing): nothing of agent-sandbox's to remove"
    guard
    c=$(containers -a) || die "cannot list the agent's containers; nothing removed"
    # shellcheck disable=SC2086 # one id per line
    [[ -z $c ]] || docker rm -f -v $c >/dev/null
    stop "$ROOT/jobs.pid" bwrap; stop "$ROOT/docker.pid" agent-docker-proxy
    # The agent's containers ran as root: hand back what they wrote (and clear any setuid bit).
    if [[ -n ${IMAGES[0]-} ]]; then
        docker run --rm --network none -v "$(volume):/w" --entrypoint chown "${IMAGES[0]}" -R "$(id -u):$(id -g)" /w >/dev/null 2>&1 ||
            warn "could not chown the workspace back; root-owned files may stay"
    fi
    docker volume rm -f "$(volume)" >/dev/null 2>&1 || true
    rewrite_keys
    if ((CREATED)); then
        rm -rf -- "$WORKSPACE"
        rmdir "$HOME/agent-sandbox" 2>/dev/null || true # only if this was its last workspace
    else
        echo "agent-sandbox: kept $WORKSPACE: it existed before the session" >&2
    fi
    rm -rf -- "$ROOT"
    [[ -n $(containers -a) ]] && left+=("the agent's containers")
    docker volume inspect "$(volume)" >/dev/null 2>&1 && left+=("volume $(volume)")
    pgrep -f -- "-S $WORKSPACE/.agent-jobs.sock" >/dev/null && left+=("the jobs jail")
    grep -qF -- "$KBLOB" "$HOME/.ssh/authorized_keys" && left+=("key line")
    ((CREATED)) && [[ -e $WORKSPACE ]] && left+=("$WORKSPACE")
    [[ -e $ROOT ]] && left+=("$ROOT")
    ((${#left[@]} == 0)) || die "left behind: ${left[*]}"
    echo "agent-sandbox: $NAME removed; nothing left (containers, jail, key, workspace, $ROOT)"
}

cmd_status() {
    load_session || { echo "agent-sandbox: no session"; return 0; }
    echo "session $NAME workspace=$WORKSPACE network=$NETWORK images=${IMAGES[*]:-none}"
    alive "$ROOT/jobs.pid" bwrap && echo "jobs jail: running" || echo "jobs jail: NOT running"
    alive "$ROOT/docker.pid" agent-docker-proxy && echo "docker proxy: running" || echo "docker proxy: NOT running"
    echo "agent's containers: $(containers | tr '\n' ' ')"
    grep -o 'expiry-time="[^"]*"' "$HOME/.ssh/authorized_keys" | head -1 | sed 's/^/key /'
}

# Run a command in a fresh jail (its own pid namespace: it ends with the command).
gate_run() { jail_args; "${JAIL[@]}" -- "$@"; }

# Everything the sandbox key asks for runs in the jail, never on the host:
# SSH_ORIGINAL_COMMAND is handed to the jail's shell as one argument.
cmd_gate() {
    local cmd=${SSH_ORIGINAL_COMMAND-}
    [[ $cmd == "$PROBE" ]] && { echo "agent-sandbox: gated $NAME"; return 0; }
    # On the host, where the agent cannot reach it; no record, no command.
    printf '%s %q\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${cmd:-(interactive shell)}" >>"$ROOT/audit.log" ||
        die "cannot write the audit log; refusing to run"
    load_session && [[ $NAME == "$1" ]] ||
        die "sandbox '$1' is not running. A human must start it: ssh-sandbox up <host>"
    jail_args
    case $cmd in
        "") exec "${JAIL[@]}" -- bash -l ;;
        *sftp-server* | internal-sftp)
            for s in /usr/lib/openssh/sftp-server /usr/libexec/openssh/sftp-server /usr/lib/ssh/sftp-server; do
                [[ -x $s ]] && exec "${JAIL[@]}" -- "$s"
            done
            die "no sftp-server here; use rsync or ssh cat" ;;
        *) exec "${JAIL[@]}" -- bash -lc "$cmd" ;;
    esac
}

sub=${1:-}; (($#)) && shift
case $sub in
    up) parse_opts "$@"; cmd_up ;;
    down) parse_opts "$@"; cmd_down ;;
    status) cmd_status ;;
    gate) (($# == 1)) && [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "gate takes exactly the sandbox name"; cmd_gate "$1" ;;
    -h | --help | help) usage ;;
    *) usage >&2; exit 2 ;;
esac
