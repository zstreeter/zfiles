#!/usr/bin/env bash
# agent-sandbox -- server half of the ssh agent sandbox. ssh-sandbox (the laptop half)
# ships this file into ~/.agent-sandbox/ for one session and runs it over your normal
# ssh; `down` removes the container, the key and every file the session made, this
# one included. In between, the sandbox key's every login is forced into `gate`.
set -euo pipefail

ROOT=$HOME/.agent-sandbox # a dot-directory: check_source refuses to mount it
SESSION=$ROOT/session
LABEL=zfiles.agent-sandbox
PROBE=agent-sandbox-probe
# shellcheck disable=SC2016 # expanded by the container's shell, not this one
TOOLS='PATH="$PATH:/opt/agent-sandbox/bin"; export PATH; ' # staged tools last: the image's own win

die()  { echo "agent-sandbox: $*" >&2; exit 1; }
warn() { echo "agent-sandbox: warning: $*" >&2; }

usage() {
    cat <<EOF
usage: agent-sandbox <command> [options]      (run by ssh-sandbox; not by hand)
  up [opts] < KEY.pub   fresh container + this key forced into 'gate NAME' until --ttl
  down [--force]        remove container, key, workspace and $ROOT; verify nothing is left
                        ($ROOT/audit.log, one line per sandbox-key request, goes with it:
                        ssh-sandbox down copies it home first)
  status                state and the security-relevant settings of the container
  gate NAME             the forced command of the sandbox key (sshd runs it)

up options:
  --image IMAGE          image to run (required); pin by digest (IMAGE@sha256:...)
  --name NAME            container name (default: \${USER}_agent)
  --workspace DIR        host dir at /workspace (default ~/agent-sandbox/NAME)
  --ttl HOURS            the key stops working after this, down or not (default 12)
  --from ADDRS           accept the key only from these addresses (from="..."); ssh-sandbox
                         passes the laptop's tailnet addresses when it connects over Tailscale
  --gpu auto|kfd|nvidia|nvidia:0,1|none     (default auto; kfd = /dev/kfd GPUs)
  --network none|bridge|host|NETNAME        (default none: no network at all)
  --ipc private|host                        (default private; RCCL may need host)
  --memory SIZE          memory cap (default half the host's RAM)
  --shm-size SIZE  --cpus N  --pids-limit N  --tmp-size SIZE
  --mount SRC:DST[:ro|rw]   extra bind mount (default ro), validated
  --env KEY=VALUE        container env; never put secrets here
  --rw-root              writable root filesystem (default read-only)
  --seccomp-unconfined   drop the seccomp filter (some profilers need it)
  --force                (up, down) end running agent-job jobs
EOF
}

NAME="${USER:-$(id -un)}_agent" IMAGE="" GPU=auto NETWORK=none IPC=private TTL=12
SHM=8g MEMORY="" CPUS="" PIDS=8192 TMP_SIZE=8g WORKSPACE="" RW_ROOT=0 SECCOMP=0 FORCE=0
MOUNTS=() ENVS=() CREATED="" FROM=""

size_ok() { [[ $1 =~ ^[0-9]+(\.[0-9]+)?[bkmgBKMG]?$ ]] || die "bad $2: $1"; }
name_ok() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "bad name: $1"; }

parse_opts() {
    while (($#)); do
        case $1 in
            --rw-root) RW_ROOT=1; shift; continue ;;
            --seccomp-unconfined) SECCOMP=1; shift; continue ;;
            --force) FORCE=1; shift; continue ;;
        esac
        (($# >= 2)) || die "$1 needs a value"
        case $1 in
            --name) name_ok "$2"; NAME=$2 ;;
            --image) [[ $2 =~ ^[A-Za-z0-9][A-Za-z0-9_./:@-]*$ ]] || die "bad image: $2"; IMAGE=$2 ;;
            --ttl) [[ $2 =~ ^[1-9][0-9]*$ && $2 -le 168 ]] || die "bad --ttl (hours, 1-168): $2"; TTL=$2 ;;
            --from) [[ $2 =~ ^[0-9A-Fa-f.:/]+(,[0-9A-Fa-f.:/]+)*$ ]] || die "bad --from (comma-separated addresses): $2"; FROM=$2 ;;
            --gpu) [[ $2 =~ ^(auto|kfd|nvidia|nvidia:[0-9,]+|none)$ ]] || die "bad --gpu: $2"; GPU=$2 ;;
            --network) [[ $2 =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "bad --network: $2"; NETWORK=$2 ;;
            --ipc) [[ $2 =~ ^(private|host)$ ]] || die "bad --ipc: $2"; IPC=$2 ;;
            --shm-size) size_ok "$2" "$1"; SHM=$2 ;;
            --memory) size_ok "$2" "$1"; MEMORY=$2 ;;
            --tmp-size) size_ok "$2" "$1"; TMP_SIZE=$2 ;;
            --cpus) [[ $2 =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "bad --cpus: $2"; CPUS=$2 ;;
            --pids-limit) [[ $2 =~ ^[1-9][0-9]*$ ]] || die "bad --pids-limit: $2"; PIDS=$2 ;;
            --workspace) WORKSPACE=$2 ;;
            --mount) MOUNTS+=("$2") ;;
            --env) [[ $2 =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "bad --env: $2"; ENVS+=("$2") ;;
            *) usage >&2; die "unknown option: $1" ;;
        esac
        shift 2
    done
}

# What `down` must undo, written by `up`: the session's name, workspace and key.
load_session() {
    [[ -f $SESSION ]] || return 1
    local k v
    while IFS='=' read -r k v; do
        case $k in name) NAME=$v ;; workspace) WORKSPACE=$v ;; blob) KBLOB=$v ;; created) CREATED=$v ;; esac
    done <"$SESSION"
}

# A bind mount is a hole in the sandbox. Refuse every source that would let the
# agent rewrite what runs on the host: home itself, dotfiles (ssh keys, shell rc,
# this script's session dir), system dirs, sockets -- or this script.
check_source() {
    local src home me
    src=$(realpath -e -- "$1") || die "mount source does not exist: $1"
    home=$(realpath -e -- "$HOME"); me=$(realpath -e -- "$0")
    case $src in
        / | /etc | /etc/* | /proc | /proc/* | /sys | /sys/* | /dev | /dev/* | /boot | /boot/* | \
        /run | /run/* | /var/run | /var/run/* | /usr | /usr/* | /bin | /bin/* | /sbin | /sbin/* | \
        /lib | /lib/* | /lib64 | /lib64/* | /root | /root/* | /var/lib/docker | /var/lib/docker/*)
            die "refusing to mount system path $src" ;;
    esac
    [[ $home == "$src" || $home == "$src"/* ]] && die "refusing to mount $src: it exposes your home directory"
    [[ $src == "$home"/.* ]] && die "refusing to mount $src: dot-directories hold keys, shell rc and this script"
    [[ $me == "$src"/* ]] && die "refusing to mount $src: it contains agent-sandbox itself"
    [[ -S $src ]] && die "refusing to mount socket $src"
    printf '%s' "$src"
}

docker_() { docker "$@"; }
exists() { docker_ inspect "$NAME" >/dev/null 2>&1; }
ours() { [[ $(docker_ inspect -f "{{index .Config.Labels \"$LABEL\"}}" "$NAME" 2>/dev/null) == 1 ]]; }
running() { [[ $(docker_ inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null) == true ]]; }

gpu_args() {
    local g gid
    if [[ $GPU == auto ]]; then
        if [[ -e /dev/kfd ]]; then GPU=kfd
        elif command -v nvidia-smi >/dev/null; then GPU=nvidia
        else GPU=none; fi
    fi
    case $GPU in
        kfd)
            [[ -e /dev/kfd ]] || die "--gpu kfd but /dev/kfd does not exist"
            ARGS+=(--device /dev/kfd --device /dev/dri)
            # Host group ids by number: the image's /etc/group numbers them differently.
            for g in video render; do
                gid=$(getent group "$g" | cut -d: -f3) && [[ -n $gid ]] && ARGS+=(--group-add "$gid")
            done ;;
        nvidia) ARGS+=(--gpus all) ;;
        nvidia:*) ARGS+=(--gpus "\"device=${GPU#nvidia:}\"") ;;
    esac
}

# Images often lack rsync, sftp-server and tmux, and running them on the host instead
# would follow symlinks the agent plants in /workspace. So ship the host's copies, with
# their non-libc libraries, read-only into the container: they resolve paths there.
# Each runs through the loader with --library-path, which binds that one process: an
# LD_LIBRARY_PATH would be inherited by every job tmux starts and shadow the image's libs.
stage_tools() {
    local dir=$ROOT/tools t bin ld f u g
    rm -rf "$dir"; mkdir -p "$dir/bin" "$dir/libexec" "$dir/lib"
    for t in rsync scp tmux /usr/lib/openssh/sftp-server /usr/libexec/openssh/sftp-server; do
        bin=$(command -v "$t") || continue
        ld=$(ldd "$bin" | awk '$1 ~ /^\/.*ld-linux/ {print $1; exit}')
        [[ -n $ld ]] || { warn "not staging $bin: no dynamic loader found"; continue; }
        cp -L "$bin" "$dir/libexec/"
        ldd "$bin" | awk '$3 ~ /^\// {print $3}' | { grep -vE '/(libc|libm|libpthread|libdl|librt|ld-linux)[.-][^/]*$' || true; } |
            xargs -r cp -L -t "$dir/lib/"
        printf '#!/bin/sh\nexec %s --library-path /opt/agent-sandbox/lib /opt/agent-sandbox/libexec/%s "$@"\n' "$ld" "${bin##*/}" >"$dir/bin/${bin##*/}"
        chmod 755 "$dir/bin/${bin##*/}"
    done
    install -m 755 "$(dirname "$(realpath -e -- "$0")")/agent-job" "$dir/bin/agent-job"
    ARGS+=(-v "$dir:/opt/agent-sandbox:ro")
    # The image's passwd/group plus our uid: sftp-server, whoami and getpass need a name.
    u=$(id -un) g=$(id -gn)
    for f in passwd group; do
        docker_ run --rm --network none --entrypoint cat "$IMAGE" "/etc/$f" >"$dir/$f" 2>/dev/null || : >"$dir/$f"
    done
    printf '%s:x:%s:%s::/workspace:/bin/sh\n' "$u" "$(id -u)" "$(id -g)" >>"$dir/passwd"
    printf '%s:x:%s:\n' "$g" "$(id -g)" >>"$dir/group"
    ARGS+=(-v "$dir/passwd:/etc/passwd:ro" -v "$dir/group:/etc/group:ro")
}

# What the container says reaches your terminal: no escape sequences.
printable() { tr -c '[:print:]' ' ' <<<"$1"; }

# Removing the container ends every job in it.
guard_jobs() {
    local jobs
    running || return 0
    # Not knowing is not "none": a sandbox we cannot ask may hold a week of training.
    if ! jobs=$(docker_ exec "$NAME" /opt/agent-sandbox/bin/agent-job running 2>&1); then
        ((FORCE)) && return 0
        die "cannot list jobs in $NAME ($(printable "$jobs")); pass --force to end it anyway"
    fi
    [[ -z $jobs ]] && return 0
    ((FORCE)) && { warn "ending running jobs: $(printable "$jobs")"; return 0; }
    die "jobs still running in $NAME: $(printable "$jobs")-- wait for them, agent-job kill them, or pass --force"
}

read_pubkey() {
    local key t
    key=$(head -c 16384 | tr -d '\r')
    [[ $(wc -l <<<"$key") == 1 ]] || die "expected exactly one public key on stdin"
    read -r KTYPE KBLOB _ <<<"$key"
    [[ $KTYPE =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)$ ]] ||
        die "not a bare public key (options are added here, not accepted): ${KTYPE:-empty}"
    [[ $KBLOB =~ ^[A-Za-z0-9+/]+=*$ ]] || die "malformed key blob"
    t=$(mktemp); printf '%s %s\n' "$KTYPE" "$KBLOB" >"$t"
    ssh-keygen -lf "$t" >/dev/null 2>&1 || { rm -f "$t"; die "ssh-keygen rejects this key"; }
    rm -f "$t"
}

# Rewrite authorized_keys without any line carrying this key, then optionally add one.
rewrite_keys() {
    local ak=$HOME/.ssh/authorized_keys tmp
    (umask 077 && mkdir -p "$HOME/.ssh"); touch "$ak"
    tmp=$(mktemp "$HOME/.ssh/.authorized_keys.XXXXXX")
    awk -v b="$KBLOB" '{ for (i = 1; i <= NF; i++) if ($i == b) next } 1' "$ak" >"$tmp"
    [[ -n ${1-} ]] && printf '%s\n' "$1" >>"$tmp"
    chmod 600 "$tmp" && mv -f "$tmp" "$ak"
}

cmd_up() {
    local ws m src dst mode me expiry
    [[ -n $IMAGE ]] || die "no image: pass --image"
    [[ $IMAGE == *@sha256:* ]] || warn "$IMAGE is not pinned by digest; a retag changes what runs"
    local want=$NAME want_ws=$WORKSPACE
    if load_session; then
        [[ $NAME == "$want" ]] || die "a session named $NAME is already here: ssh-sandbox down it first"
        # down removes the session's workspace by what up recorded: never switch it mid-session.
        [[ -z $want_ws || $(realpath -m -- "$want_ws") == "$WORKSPACE" ]] ||
            die "this session's workspace is $WORKSPACE: ssh-sandbox down it first to use $want_ws"
    fi
    NAME=$want
    read_pubkey
    me=$(realpath -e -- "$0")
    [[ $me == "$ROOT/agent-sandbox" ]] || die "run from $ROOT (ssh-sandbox ships it there), not $me"
    [[ $me =~ ^/[A-Za-z0-9_./-]+$ ]] || die "path unsafe to quote in authorized_keys: $me"
    if exists; then
        ours || die "container '$NAME' exists but agent-sandbox did not create it; refusing to touch it"
        guard_jobs
    fi
    WORKSPACE=${WORKSPACE:-$HOME/agent-sandbox/$NAME}
    # down deletes the workspace only if this session made it: never a directory you had.
    if [[ -e $WORKSPACE ]]; then CREATED=${CREATED:-0}; else CREATED=1; fi
    (umask 077 && mkdir -p "$WORKSPACE")
    ws=$(check_source "$WORKSPACE")
    [[ -n $MEMORY ]] || MEMORY=$(awk '/^MemTotal:/ {print int($2 / 2) "k"}' /proc/meminfo)

    ARGS=(run -d --name "$NAME" --label "$LABEL=1" --hostname "$NAME" --init --restart no
        --user "$(id -u):$(id -g)" -e HOME=/workspace -e "USER=$(id -un)" -e "LOGNAME=$(id -un)"
        -e AGENT_SANDBOX=1 -e "AGENT_SANDBOX_IMAGE=$IMAGE"
        --cap-drop ALL --security-opt no-new-privileges:true
        --pids-limit "$PIDS" --ipc "$IPC" --shm-size "$SHM" --network "$NETWORK" --memory "$MEMORY"
        -v "$ws:/workspace:rw" -w /workspace)
    if ((!RW_ROOT)); then
        ARGS+=(--read-only --tmpfs "/tmp:rw,exec,nosuid,nodev,size=$TMP_SIZE" --tmpfs "/var/tmp:rw,exec,nosuid,nodev,size=1g")
    else warn "root filesystem is writable (--rw-root)"; fi
    ((SECCOMP)) && { ARGS+=(--security-opt seccomp=unconfined); warn "seccomp filter disabled"; }
    [[ $NETWORK != none ]] && warn "--network $NETWORK: the agent can reach the network (internet, host services on 0.0.0.0, cloud metadata)"
    [[ $NETWORK == host ]] && warn "--network host: the agent reaches every service on the host's localhost"
    [[ $IPC == host ]] && warn "--ipc host: the agent shares the host's IPC namespace"
    [[ -n $CPUS ]] && ARGS+=(--cpus "$CPUS")
    for m in "${MOUNTS[@]}"; do
        IFS=: read -r src dst mode <<<"$m"
        mode=${mode:-ro}
        [[ $dst == /?* && $dst != *:* && $dst != /workspace ]] || die "bad mount target in: $m"
        [[ $mode =~ ^(ro|rw)$ ]] || die "bad mount mode in: $m"
        ARGS+=(-v "$(check_source "$src"):$dst:$mode")
    done
    for m in "${ENVS[@]}"; do ARGS+=(-e "$m"); done
    gpu_args
    # Everything above validated; only now replace the running sandbox.
    exists && docker_ rm -f -v "$NAME" >/dev/null
    stage_tools
    ARGS+=(--entrypoint sleep "$IMAGE" infinity)
    docker_ "${ARGS[@]}" >/dev/null
    printf 'name=%s\nworkspace=%s\nblob=%s\ncreated=%s\n' "$NAME" "$ws" "$KBLOB" "$CREATED" >"$SESSION"
    : >>"$ROOT/audit.log" # exists from the start, so down can always copy it
    # restrict: no agent/port/X11 forwarding, no ~/.ssh/rc; pty back on for shells.
    # expiry-time: the key dies on its own if `down` never runs (laptop lost, session abandoned).
    expiry=$(date -d "+$TTL hours" +%Y%m%d%H%M) # server-local: sshd before 9.x rejects a Z suffix
    rewrite_keys "restrict,pty,${FROM:+from=\"$FROM\",}expiry-time=\"$expiry\",command=\"$me gate $NAME\" $KTYPE $KBLOB agent-sandbox"
    echo "agent-sandbox: $NAME up (gpu=$GPU network=$NETWORK memory=$MEMORY workspace=$ws, key expires $expiry${FROM:+, only from $FROM})"
}

# Undo all of `up`, then prove it: no container, no key line, no workspace, no $ROOT.
cmd_down() {
    local left=()
    load_session || die "no session here ($SESSION missing): nothing of agent-sandbox's to remove"
    if exists; then
        ours || die "container '$NAME' was not created by agent-sandbox; refusing to remove it"
        guard_jobs
        docker_ rm -f -v "$NAME" >/dev/null
    fi
    rewrite_keys
    if ((CREATED)); then
        rm -rf -- "$WORKSPACE"
        rmdir "$HOME/agent-sandbox" 2>/dev/null || true # only if this was its last workspace
    else
        echo "agent-sandbox: kept $WORKSPACE: it existed before the session" >&2
    fi
    rm -rf -- "$ROOT"
    exists && left+=("container $NAME")
    grep -qF -- "$KBLOB" "$HOME/.ssh/authorized_keys" && left+=("key line")
    ((CREATED)) && [[ -e $WORKSPACE ]] && left+=("$WORKSPACE")
    [[ -e $ROOT ]] && left+=("$ROOT")
    ((${#left[@]} == 0)) || die "left behind: ${left[*]}"
    echo "agent-sandbox: $NAME removed; nothing left (container, key, workspace, $ROOT)"
}

cmd_status() {
    load_session || { echo "agent-sandbox: no session"; return 0; }
    exists || { echo "agent-sandbox: session $NAME, but its container does not exist"; return 0; }
    docker_ inspect -f "name={{.Name}} state={{.State.Status}} image={{.Config.Image}} user={{.Config.User}}
privileged={{.HostConfig.Privileged}} readonly_root={{.HostConfig.ReadonlyRootfs}} capdrop={{.HostConfig.CapDrop}} capadd={{.HostConfig.CapAdd}}
network={{.HostConfig.NetworkMode}} ipc={{.HostConfig.IpcMode}} memory={{.HostConfig.Memory}} pids={{.HostConfig.PidsLimit}} security={{.HostConfig.SecurityOpt}}
mounts={{range .Mounts}}{{.Source}}:{{.Destination}}:{{if .RW}}rw{{else}}ro{{end}} {{end}}" "$NAME"
    grep -o 'expiry-time="[^"]*"' "$HOME/.ssh/authorized_keys" | head -1 | sed 's/^/key /'
}

# Everything the sandbox key asks for runs inside the container, never on the host:
# SSH_ORIGINAL_COMMAND is handed to the container's shell as one argument.
cmd_gate() {
    local cmd=${SSH_ORIGINAL_COMMAND-} tty=()
    [[ $cmd == "$PROBE" ]] && { echo "agent-sandbox: gated $NAME"; return 0; }
    # On the host, where the agent cannot reach it; no record, no command.
    printf '%s %q\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${cmd:-(interactive shell)}" >>"$ROOT/audit.log" ||
        die "cannot write the audit log; refusing to run"
    if ! { exists && ours && running; }; then
        die "sandbox '$NAME' is not running. A human must start it: ssh-sandbox up <host>"
    fi
    [[ -t 0 && -t 1 ]] && tty=(-t)
    case $cmd in
        "") exec docker exec -i "${tty[@]}" "$NAME" sh -c "$TOOLS"'command -v bash >/dev/null && exec bash -l; exec sh -l' ;;
        *sftp-server* | internal-sftp)
            exec docker exec -i "$NAME" sh -c 'for s in /usr/lib/openssh/sftp-server /usr/libexec/openssh/sftp-server /usr/lib/ssh/sftp-server /opt/agent-sandbox/bin/sftp-server; do [ -x "$s" ] && exec "$s"; done; echo "agent-sandbox: no sftp-server in the image; use rsync or ssh cat" >&2; exit 1' ;;
        *) exec docker exec -i "${tty[@]}" "$NAME" sh -c "$TOOLS"'command -v bash >/dev/null && exec bash -lc "$1"; exec sh -lc "$1"' sh "$cmd" ;;
    esac
}

sub=${1:-}; (($#)) && shift
case $sub in
    up) parse_opts "$@"; cmd_up ;;
    down) parse_opts "$@"; cmd_down ;;
    status) cmd_status ;;
    gate) (($# == 1)) || die "gate takes exactly the sandbox name"; name_ok "$1"; NAME=$1; cmd_gate ;;
    -h | --help | help) usage ;;
    *) usage >&2; exit 2 ;;
esac
