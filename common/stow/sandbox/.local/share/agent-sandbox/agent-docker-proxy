#!/usr/bin/env python3
"""agent-docker-proxy -- the only Docker the agent's jail can reach.

agent-sandbox starts one per session; the jail's DOCKER_HOST is its socket. It passes
a request to the real daemon only if nothing in it could reach past the session, and
otherwise refuses it with a message saying why. It refuses, never fixes up: what runs
is what the repo asked for. The three rewrites are the containment itself -- a
session label (so down finds them), network none when the session has none, and
binds, which must come from the workspace and become a volume of it with Subpath, so
the daemon resolves them without following a symlink planted there out of it.

Allowlist: an endpoint, or a HostConfig key carrying a value, not named here is refused.

usage: agent-docker-proxy CONFIG.json | --self-test
"""
import json
import os
import posixpath
import re
import socket
import socketserver
import sys
import threading
import time
import urllib.parse


class Deny(Exception):
    pass


def zeroish(v):
    """What the docker CLI sends for a flag nobody passed."""
    if isinstance(v, dict):
        return all(zeroish(x) for x in v.values())
    if isinstance(v, list):
        return all(zeroish(x) for x in v)
    return v in (None, "", 0, False)


def gpu(path):
    p = posixpath.normpath(path or "")
    return p in ("/dev/kfd", "/dev/dri") or p.startswith(("/dev/dri/", "/dev/nvidia"))


# HostConfig keys a container may set, and what they may be set to. Resources, devices
# of the GPU, ipc (RCCL wants host) and seccomp=unconfined (profilers) stay inside;
# privileged, capabilities, host pid/net/user namespaces, sysctls, ports do not.
ALLOWED = {
    **dict.fromkeys(["AutoRemove", "ShmSize", "Tmpfs", "Init", "Ulimits", "GroupAdd", "ConsoleSize",
                     "ReadonlyRootfs", "CapDrop", "Memory", "MemorySwap", "MemoryReservation",
                     "MemorySwappiness", "NanoCpus", "CpuShares", "CpuPeriod", "CpuQuota", "CpusetCpus",
                     "CpusetMems", "PidsLimit", "BlkioWeight", "OomScoreAdj", "Dns", "DnsOptions",
                     "DnsSearch", "ExtraHosts", "ContainerIDFile", "Isolation", "DeviceRequests",
                     "Binds", "Mounts"], lambda v: True),
    "NetworkMode": lambda v: v in ("default", "bridge", "none"),
    "IpcMode": lambda v: v in ("private", "shareable", "none", "host"),
    "CgroupnsMode": lambda v: v == "private",
    "RestartPolicy": lambda v: v.get("Name") in ("", "no"),
    "LogConfig": lambda v: v.get("Type") in ("", "json-file", "local"),
    "SecurityOpt": lambda v: all(o.startswith("no-new-privileges") or o in ("seccomp=unconfined", "seccomp:unconfined") for o in v),
    "Devices": lambda v: all(gpu(d.get("PathOnHost")) for d in v),
}


def mount(cfg, src, dst, ro):
    ws = cfg["workspace"]
    p = posixpath.normpath(src or "")
    if not p.startswith("/") or (p != ws and not p.startswith(ws + "/")):
        raise Deny(f"mount source {src!r}: only paths under the workspace {ws}")
    m = {"Type": "volume", "Source": cfg["volume"], "Target": dst, "ReadOnly": bool(ro)}
    if p != ws:
        m["VolumeOptions"] = {"Subpath": p[len(ws) + 1:]}
    return m


def mounts(cfg, h):
    out = []
    for b in h.get("Binds") or []:
        src, dst, *opt = b.split(":")
        opts = set(opt[0].split(",")) if opt else set()
        if len(opt) > 1 or opts - {"ro", "rw"}:
            raise Deny(f"bind {b!r}: only SRC:DST[:ro|rw]")
        out.append(mount(cfg, src, dst, "ro" in opts))
    for m in h.get("Mounts") or []:
        if m.get("Type") == "tmpfs":
            out.append(m)
        elif m.get("Type") == "bind" and zeroish(m.get("BindOptions")):
            out.append(mount(cfg, m.get("Source"), m.get("Target"), m.get("ReadOnly")))
        else:
            raise Deny(f"mount {m}: only binds from the workspace, and tmpfs")
    return out


def create(cfg, body, image_id):
    """Check a POST /containers/create body; return it with the three rewrites."""
    try:
        c = json.loads(body or b"{}")
        h = c.get("HostConfig") or {}
    except (ValueError, AttributeError):
        raise Deny("container config is not a JSON object")
    iid = image_id(c.get("Image") or "")
    if iid is None or iid not in {image_id(i) for i in cfg["images"]}:
        raise Deny(f"image {c.get('Image')!r} is not one of this session's ({', '.join(cfg['images']) or 'none'}); "
                   "a human adds one with: ssh-sandbox up <host> --image IMAGE")
    for k in ("MaskedPaths", "ReadonlyPaths"):  # [] is not the default: it unmasks /proc and /sys
        if h.get(k) is not None:
            raise Deny(f"HostConfig.{k}")
    for k, v in h.items():
        if not zeroish(v) and not ALLOWED.get(k, lambda v: False)(v):
            raise Deny(f"HostConfig.{k}={json.dumps(v)} is not allowed in the sandbox")
    h["Mounts"], h["Binds"] = mounts(cfg, h), None
    if cfg["network"] == "none":
        h["NetworkMode"], c["NetworkingConfig"] = "none", None
    c["HostConfig"] = h
    c["Labels"] = dict(c.get("Labels") or {}, **{cfg["label"]: cfg["name"]})
    return json.dumps(c).encode()


OWN = {("POST", "start"), ("POST", "attach"), ("POST", "wait"), ("GET", "json"), ("GET", "logs"),
       ("POST", "kill"), ("POST", "stop"), ("POST", "restart"), ("POST", "resize"), ("GET", "top"),
       ("GET", "stats"), ("DELETE", None)}


def route(cfg, method, target, body, inspect):
    """(target, body) to send upstream, or Deny. inspect(path) -> parsed JSON or None."""
    u = urllib.parse.urlsplit(target)
    path = re.sub(r"^/v[0-9.]+(?=/)", "", u.path)

    def image_id(ref):
        j = inspect(f"/images/{urllib.parse.quote(ref, safe='')}/json") if ref else None
        return j.get("Id") if isinstance(j, dict) else None

    if (method, path) in {("GET", "/_ping"), ("HEAD", "/_ping"), ("GET", "/version"), ("GET", "/info"),
                          ("GET", "/images/json")} or (method == "GET" and re.fullmatch(r"/images/.+/json", path)):
        return target, body
    if (method, path) == ("POST", "/containers/create"):
        return target, create(cfg, body, image_id)
    if (method, path) == ("GET", "/containers/json"):  # only the session's
        q = urllib.parse.parse_qs(u.query)
        q["filters"] = [json.dumps({"label": [f"{cfg['label']}={cfg['name']}"]})]
        return f"{u.path}?{urllib.parse.urlencode(q, doseq=True)}", body
    m = re.fullmatch(r"/containers/([^/]+)(?:/([a-z]+))?", path)
    if m and (method, m[2]) in OWN:
        j = inspect(f"/containers/{urllib.parse.quote(urllib.parse.unquote(m[1]), safe='')}/json")
        if (((j or {}).get("Config") or {}).get("Labels") or {}).get(cfg["label"]) != cfg["name"]:
            raise Deny(f"container {urllib.parse.unquote(m[1])} is not one this session started")
        return target, body
    raise Deny(f"{method} {path} is not available in the sandbox")


# --- transport: one request per connection, so nothing after it skips the check ---

def upstream_get(cfg, path):
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(cfg["upstream"])
        s.sendall(f"GET {path} HTTP/1.0\r\nHost: docker\r\n\r\n".encode())
        data = b"".join(iter(lambda: s.recv(65536), b""))
    head, _, body = data.partition(b"\r\n\r\n")
    try:
        return json.loads(body) if head.split()[1] == b"200" else None
    except (ValueError, IndexError):
        return None


def pump(src, dst):
    try:
        while chunk := src.recv(65536):
            dst.sendall(chunk)
    except OSError:
        pass
    try:
        dst.shutdown(socket.SHUT_WR)
    except OSError:
        pass


class Handler(socketserver.BaseRequestHandler):
    def handle(self):
        cfg, c = self.server.cfg, self.request
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = c.recv(65536)
            if not chunk or len(buf) > 65536:
                return
            buf += chunk
        head, _, rest = buf.partition(b"\r\n\r\n")
        lines = head.decode("latin-1").split("\r\n")
        method, target = (lines[0].split(" ") + ["", ""])[:2]
        hdrs = [tuple(x.strip() for x in ln.split(":", 1)) for ln in lines[1:] if ":" in ln]
        low = {k.lower(): v for k, v in hdrs}
        try:
            if "transfer-encoding" in low:
                raise Deny("streamed request bodies (docker build, cp, load) are not available")
            n = int(low.get("content-length", "0"))
            if n > 1 << 20:
                raise Deny("request body too large")
            while len(rest) < n and (chunk := c.recv(65536)):
                rest += chunk
            body, rest = rest[:n], rest[n:]
            target, body = route(cfg, method, target, body, lambda p: upstream_get(cfg, p))
        except Deny as e:
            self.server.audit(f"deny {method} {target}: {e}")
            msg = json.dumps({"message": f"agent-sandbox: {e}"}).encode()
            c.sendall(b"HTTP/1.1 403 Forbidden\r\nContent-Type: application/json\r\nConnection: close\r\n"
                      b"Content-Length: %d\r\n\r\n%s" % (len(msg), msg))
            return
        self.server.audit(f"allow {method} {target}")
        upgrade = "upgrade" in low
        out = [f"{method} {target} HTTP/1.1"] + [f"{k}: {v}" for k, v in hdrs if k.lower() not in ("content-length", "connection")]
        out += [f"Content-Length: {len(body)}", "Connection: " + ("Upgrade" if upgrade else "close")]
        with socket.socket(socket.AF_UNIX) as up:
            up.connect(cfg["upstream"])
            up.sendall(("\r\n".join(out) + "\r\n\r\n").encode("latin-1") + body)
            if upgrade:  # attach: a raw stream both ways from here on
                up.sendall(rest)
                threading.Thread(target=pump, args=(c, up), daemon=True).start()
            pump(up, c)


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True

    def __init__(self, cfg):
        self.cfg, self.lock = cfg, threading.Lock()
        if os.path.exists(cfg["socket"]):
            os.unlink(cfg["socket"])
        super().__init__(cfg["socket"], Handler)
        os.chmod(cfg["socket"], 0o600)

    def audit(self, line):
        with self.lock, open(self.cfg["audit"], "a") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} docker {line}\n")


def self_test():
    cfg = {"name": "s", "label": "L", "volume": "V", "workspace": "/h/ws", "network": "none", "images": ["ok:1"]}
    objs = {"/images/ok%3A1/json": {"Id": "a"}, "/images/a/json": {"Id": "a"}, "/images/bad/json": {"Id": "b"},
            "/containers/mine/json": {"Config": {"Labels": {"L": "s"}}}, "/containers/theirs/json": {"Config": {}}}

    def r(method, target, body=b""):
        return route(cfg, method, target, body, objs.get)

    def run(host=None, image="ok:1", **cfgover):
        return json.loads(route(dict(cfg, **cfgover), "POST", "/v1.45/containers/create",
                                json.dumps({"Image": image, "HostConfig": host or {}}).encode(), objs.get)[1])

    def denied(f, *a, **k):
        try:
            f(*a, **k)
        except Deny:
            return True

    # What a typical GPU runner asks for, as root, passes untouched but for the three rewrites.
    runner = {"Binds": ["/h/ws/repo:/workspace", "/h/ws:/w:ro"], "IpcMode": "host", "ShmSize": 1 << 37,
           "SecurityOpt": ["seccomp=unconfined"], "GroupAdd": ["video", "110"], "AutoRemove": True,
           "Devices": [{"PathOnHost": "/dev/kfd"}, {"PathOnHost": "/dev/dri/renderD128"}],
           "LogConfig": {"Type": "", "Config": {}}, "RestartPolicy": {"Name": "no"}, "Privileged": False}
    c = run(dict(runner))
    h = c["HostConfig"]
    assert c["Labels"] == {"L": "s"} and h["NetworkMode"] == "none" and "User" not in c
    assert h["IpcMode"] == "host" and h["SecurityOpt"] == ["seccomp=unconfined"] and h["GroupAdd"] == ["video", "110"]
    assert h["Binds"] is None and h["Mounts"] == [
        {"Type": "volume", "Source": "V", "Target": "/workspace", "ReadOnly": False, "VolumeOptions": {"Subpath": "repo"}},
        {"Type": "volume", "Source": "V", "Target": "/w", "ReadOnly": True}], h["Mounts"]
    assert "NetworkMode" not in run(network="host")["HostConfig"]
    assert run(image="a")["Image"] == "a"
    for bad in [{"Privileged": True}, {"CapAdd": ["SYS_ADMIN"]}, {"PidMode": "host"}, {"NetworkMode": "host"},
                {"UsernsMode": "host"}, {"UTSMode": "host"}, {"CgroupnsMode": "host"}, {"Binds": ["/etc:/x"]},
                {"Binds": ["/h/ws/../x:/x"]}, {"Binds": ["/h/ws2:/x"]}, {"Binds": ["vol:/x"]}, {"Binds": ["/h/ws:/x:z"]},
                {"Binds": ["/h/ws:/x:rshared"]}, {"Mounts": [{"Type": "volume", "Source": "V", "Target": "/x"}]},
                {"Mounts": [{"Type": "bind", "Source": "/", "Target": "/x"}]},
                {"Mounts": [{"Type": "bind", "Source": "/h/ws", "Target": "/x", "BindOptions": {"Propagation": "rshared"}}]},
                {"Devices": [{"PathOnHost": "/dev/sda"}]}, {"Devices": [{"PathOnHost": "/dev/dri/../sda"}]},
                {"SecurityOpt": ["apparmor=unconfined"]}, {"SecurityOpt": ["label=disable"]}, {"Sysctls": {"a": "1"}},
                {"VolumesFrom": ["x"]}, {"CgroupParent": "/"}, {"PortBindings": {"22/tcp": [{"HostPort": "22"}]}},
                {"PublishAllPorts": True}, {"Runtime": "x"}, {"DeviceCgroupRules": ["a *:* rwm"]}, {"MaskedPaths": []},
                {"ReadonlyPaths": ["/x"]}, {"RestartPolicy": {"Name": "always"}}, {"LogConfig": {"Type": "syslog"}},
                {"OomKillDisable": True}, {"SomethingNew": 1}]:
        assert denied(run, bad), bad
    assert denied(run, image="bad") and denied(run, image="missing") and denied(run, image="")
    assert r("GET", "/v1.45/containers/mine/json") and r("DELETE", "/v1.45/containers/mine?force=1")
    for m, t in [("GET", "/containers/theirs/json"), ("POST", "/containers/theirs/kill"), ("DELETE", "/containers/theirs"),
                 ("POST", "/containers/mine/exec"), ("PUT", "/containers/mine/archive"), ("POST", "/images/create"),
                 ("POST", "/build"), ("POST", "/volumes/create"), ("GET", "/events"), ("POST", "/exec/x/start"),
                 ("POST", "/containers/mine/update"), ("POST", "/networks/create"), ("POST", "/images/x/tag")]:
        assert denied(r, m, "/v1.45" + t), (m, t)
    t, _ = r("GET", "/v1.45/containers/json?all=1&filters=%7B%7D")
    assert json.loads(urllib.parse.parse_qs(urllib.parse.urlsplit(t).query)["filters"][0]) == {"label": ["L=s"]}
    print("agent-docker-proxy: self-test ok")


def main():
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    with open(sys.argv[1]) as f:
        cfg = json.load(f)
    srv = Server(cfg)
    with open(cfg["pidfile"], "w") as f:
        f.write(f"{os.getpid()}\n")
    srv.serve_forever()


if __name__ == "__main__":
    main()
