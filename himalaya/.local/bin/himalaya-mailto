#!/usr/bin/env bash
# himalaya-mailto — mailto: URI handler that opens himalaya in ghostty.
# Wired up by himalaya.desktop (MimeType=x-scheme-handler/mailto).
#
# himalaya v2 dropped v1's interactive `message write -H "To:..."` editor flow.
# v2's `message compose` is a non-interactive stdout composer, so we assemble
# the draft with it, open $EDITOR on the result, then send/save-draft/discard.
#
# Desktop-file launches don't inherit zsh PATH, so prepend the cargo bin
# dir explicitly — himalaya is installed via `cargo install` (see bootstrap.sh §8).
set -euo pipefail

export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/cargo/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:${PATH:-}"

urldecode() {
    local data="${1//+/ }"
    printf '%b' "${data//%/\\x}"
}

uri="${1:-}"
to="" subject="" body="" cc="" bcc=""

if [[ -n "$uri" ]]; then
    rest="${uri#mailto:}"
    if [[ "$rest" == *\?* ]]; then
        to="$(urldecode "${rest%%\?*}")"
        IFS='&' read -ra parts <<< "${rest#*\?}"
        for part in "${parts[@]}"; do
            key="${part%%=*}"
            val="$(urldecode "${part#*=}")"
            case "${key,,}" in
                subject) subject="$val" ;;
                body)    body="$val" ;;
                cc)      cc="$val" ;;
                bcc)     bcc="$val" ;;
            esac
        done
    else
        to="$(urldecode "$rest")"
    fi
fi

# No recipient/content at all → just open the TUI.
if [[ -z "$to" && -z "$subject" && -z "$body" ]]; then
    exec ghostty -e himalaya-tui
fi

# compose doesn't inject From:, and send needs it for the SMTP envelope.
# ponytail: assumes the default account is the first `from=` in the config.
config="${HIMALAYA_CONFIG:-$HOME/.config/himalaya/config.toml}"
from_addr="$(grep -m1 -oP '^from\s*=\s*"\K[^"]+' "$config" || true)"

args=(message compose)
[[ -n "$from_addr" ]] && args+=(--from "$from_addr")
[[ -n "$to" ]]        && args+=(--to "$to")
[[ -n "$subject" ]]   && args+=(--subject "$subject")
[[ -n "$cc" ]]        && args+=(--cc "$cc")
[[ -n "$bcc" ]]       && args+=(--bcc "$bcc")
[[ -n "$body" ]]      && args+=(--body "$body")

tmp="$(mktemp --suffix=.eml)"
himalaya "${args[@]}" </dev/null > "$tmp"

# Edit + confirm inside the terminal. Plain `bash -c` (not -l) so the PATH we
# exported above survives into the child.
exec ghostty -e bash -c '
    set -euo pipefail
    tmp="$1"
    trap "rm -f \"$tmp\"" EXIT
    "${EDITOR:-nvim}" "$tmp"
    printf "\nSend this message? [y=send / d=draft / N=discard] "
    read -r ans
    case "$ans" in
        y|Y) himalaya message send --save sent < "$tmp" && echo "Sent." ;;
        d|D) himalaya message add --mailbox drafts < "$tmp" && echo "Saved to drafts." ;;
        *)   echo "Discarded." ;;
    esac
    printf "Press enter to close."; read -r _
' _ "$tmp"
